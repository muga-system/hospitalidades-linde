---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActionLink from '../../components/global/ActionLink.astro';
import { guides } from '../../data/content';
---

<BaseLayout title="Guías — LINDE" description="Guías demo para aprender a leer un terreno, un programa y una hospitalidad de pequeña escala.">
  <div class="page guides-index">
    <header class="article-head"><div class="contained article-head__grid"><div><p class="eyebrow">Guías LINDE</p><h1 class="page-title">Ideas para mirar mejor antes de dibujar.</h1></div><p class="article-head__intro body-copy">Estas publicaciones son contenido demostrativo: muestran un tono editorial posible para acompañar las decisiones de quien está pensando un lugar.</p></div></header>
    <section class="guides-index__lead"><div class="contained guides-index__lead-grid"><figure class="media media--rounded"><img class="media__image" src={guides[0].cover.src} alt={guides[0].cover.alt} width="1536" height="1024" fetchpriority="high" style={`object-position:${guides[0].cover.position};`} /></figure><article><p class="eyebrow">{guides[0].category} · Guía destacada</p><h2>{guides[0].title}</h2><p>{guides[0].description}</p><ActionLink href={`/guias/${guides[0].slug}/`} label="Leer guía" /></article></div></section>
    <section class="section"><div class="contained guides-index__grid">{guides.slice(1).map((guide) => <article class="guides-index__card"><a href={`/guias/${guide.slug}/`}><figure class="media media--rounded"><img class="media__image" src={guide.cover.src} alt={guide.cover.alt} width={guide.cover.width} height={guide.cover.height} loading="lazy" style={`object-position:${guide.cover.position};`} /></figure><p class="eyebrow">{guide.category}</p><h2>{guide.title}</h2><p>{guide.description}</p><span>Leer guía ↗</span></a></article>)}</div></section>
    <section class="guides-index__note section--leaf"><div class="contained"><p class="eyebrow">Contenido de muestra</p><p class="body-large">En una publicación real, este espacio puede convertirse en una biblioteca de decisiones útiles, con autoría, evidencia y proyectos relacionados.</p></div></section>
  </div>
</BaseLayout>

<style>
  .guides-index__lead { padding-bottom: clamp(4rem, 8vw, 8rem); }
  .guides-index__lead-grid { display: grid; grid-template-columns: 1.1fr .68fr; gap: clamp(2rem, 7vw, 9rem); align-items: center; }
  .guides-index__lead figure { min-height: 34rem; }
  .guides-index__lead article .eyebrow { margin-bottom: .85rem; color: var(--forest); }
  .guides-index__lead article h2, .guides-index__card h2 { font-family: var(--display); font-weight: 400; line-height: .92; letter-spacing: -.06em; }
  .guides-index__lead article h2 { font-size: clamp(3rem, 5.6vw, 6rem); }
  .guides-index__lead article > p:not(.eyebrow) { margin-top: 1.2rem; font-size: .9rem; line-height: 1.55; }
  .guides-index__lead .action-link { margin-top: 1.6rem; }
  .guides-index__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1.2rem, 3vw, 3.5rem); }
  .guides-index__card figure { aspect-ratio: 1.32 / 1; }
  .guides-index__card .eyebrow { margin-top: 1rem; color: var(--forest); }
  .guides-index__card h2 { margin-top: .5rem; font-size: clamp(2.1rem, 4vw, 4.1rem); }
  .guides-index__card > a > p:not(.eyebrow) { max-width: 42ch; margin-top: .8rem; font-size: .78rem; line-height: 1.5; }
  .guides-index__card span { display: inline-block; margin-top: 1rem; font-size: .67rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  .guides-index__note { padding-block: clamp(4rem, 8vw, 8rem); }
  .guides-index__note .eyebrow { margin-bottom: 1.1rem; }
  @media (max-width: 800px) { .guides-index__lead-grid, .guides-index__grid { grid-template-columns: 1fr; } .guides-index__lead figure { min-height: 25rem; } }
</style>
