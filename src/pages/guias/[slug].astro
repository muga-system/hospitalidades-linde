---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActionLink from '../../components/global/ActionLink.astro';
import { guides } from '../../data/content';
import type { Guide } from '../../data/types';

export function getStaticPaths() { return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide } = Astro.props as { guide: Guide };
const otherGuides = guides.filter((item) => item.slug !== guide.slug);
---

<BaseLayout title={`${guide.title} — Guías LINDE`} description={guide.description} image={guide.cover.src}>
  <article class="page guide-detail">
    <header class="guide-detail__head article-head"><div class="contained"><p class="eyebrow">{guide.category} · {new Intl.DateTimeFormat('es-AR', { month: 'long', year: 'numeric' }).format(new Date(`${guide.publishedAt}T12:00:00`))} · Demo</p><h1 class="page-title">{guide.title}</h1><p class="guide-detail__deck body-large">{guide.description}</p></div></header>
    <figure class="guide-detail__cover media"><img class="media__image" src={guide.cover.src} alt={guide.cover.alt} width={guide.cover.width} height={guide.cover.height} fetchpriority="high" style={`object-position:${guide.cover.position};`} /></figure>
    <div class="contained guide-detail__content"><aside><p class="meta">Guía de muestra</p><p>Lectura estimada<br />3 minutos</p><ActionLink href="/empezar/" label="Contanos tu caso" /></aside><div class="guide-detail__body">{guide.body.map((paragraph, index) => <p class:list={{ 'guide-detail__lead': index === 0 }}>{paragraph}</p>)}<blockquote>El lugar no se termina de entender en una foto. Por eso el proyecto empieza antes del plano.</blockquote><p>Este texto no reemplaza una consulta profesional ni presenta información técnica aplicable a una obra específica. Es una pieza editorial demostrativa dentro del sistema de LINDE.</p></div></div>
    <section class="guide-detail__related section--surface"><div class="contained"><div class="section-head"><div><p class="eyebrow">Seguir leyendo</p><h2 class="section-title">Otras preguntas para hacerle al lugar.</h2></div><ActionLink href="/guias/" label="Ver todas las guías" /></div><div class="guide-detail__related-grid">{otherGuides.map((item) => <article><a href={`/guias/${item.slug}/`}><p class="eyebrow">{item.category}</p><h3>{item.title}</h3><p>{item.description}</p><span>Leer ↗</span></a></article>)}</div></div></section>
  </article>
</BaseLayout>

<style>
  .guide-detail__head { padding-bottom: clamp(3rem, 7vw, 7rem); }
  .guide-detail__head .eyebrow { margin-bottom: 1rem; color: var(--forest); }
  .guide-detail__head h1 { max-width: 14ch; }
  .guide-detail__deck { margin-top: 2rem; }
  .guide-detail__cover { height: min(72svh, 820px); }
  .guide-detail__content { display: grid; grid-template-columns: .3fr .7fr; gap: clamp(2.5rem, 9vw, 12rem); padding-block: clamp(4.5rem, 10vw, 11rem); }
  .guide-detail__content aside { position: sticky; top: calc(var(--header-height) + 1.2rem); align-self: start; font-size: .72rem; line-height: 1.55; }
  .guide-detail__content aside .meta { margin-bottom: .6rem; color: var(--forest); }
  .guide-detail__content aside .action-link { margin-top: 1.5rem; }
  .guide-detail__body { max-width: 44rem; }
  .guide-detail__body p { font-family: var(--display); font-size: clamp(1.7rem, 2.7vw, 2.7rem); line-height: 1.18; letter-spacing: -.03em; }
  .guide-detail__body p + p { margin-top: 1.7rem; }
  .guide-detail__body .guide-detail__lead { font-size: clamp(2.1rem, 3.5vw, 3.7rem); line-height: 1.06; letter-spacing: -.05em; }
  .guide-detail__body blockquote { margin: clamp(3rem, 7vw, 7rem) 0; padding-left: 1.4rem; border-left: 2px solid var(--earth); font-family: var(--display); font-size: clamp(2.2rem, 4vw, 4.5rem); line-height: .98; letter-spacing: -.06em; }
  .guide-detail__related { padding-block: clamp(4rem, 8vw, 9rem); }
  .guide-detail__related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .guide-detail__related-grid article { min-height: 17rem; display: flex; padding: clamp(1.4rem, 3vw, 3rem); background: var(--surface); }
  .guide-detail__related-grid a { display: flex; flex-direction: column; }
  .guide-detail__related-grid .eyebrow { color: var(--forest); }
  .guide-detail__related-grid h3 { max-width: 13ch; margin-top: auto; font-family: var(--display); font-size: clamp(2rem, 3.4vw, 3.8rem); font-weight: 400; line-height: .93; letter-spacing: -.06em; }
  .guide-detail__related-grid p:not(.eyebrow) { margin-top: 1rem; font-size: .76rem; line-height: 1.5; }
  .guide-detail__related-grid span { margin-top: 1rem; font-size: .67rem; font-weight: 700; text-transform: uppercase; }
  @media (max-width: 800px) { .guide-detail__content { grid-template-columns: 1fr; } .guide-detail__content aside { position: static; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; } .guide-detail__content aside .action-link { margin: 0; } }
  @media (max-width: 560px) { .guide-detail__cover { height: 52svh; } .guide-detail__related-grid { grid-template-columns: 1fr; } }
</style>
