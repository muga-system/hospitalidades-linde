---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActionLink from '../../components/global/ActionLink.astro';
import { models, projects, statusLabel } from '../../data/content';
import type { Project } from '../../data/types';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const hero = project.images[0];
const projectModel = models.find((model) => model.slug === project.modelSlugs[0]);
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const previousProject = projects[(projectIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(projectIndex + 1) % projects.length];
const siteConditions = project.technicalNotes.filter((note) => note.label !== 'Estado');
---

<BaseLayout title={`${project.name} — Proyectos LINDE`} description={project.intro} image={hero.src} headerMode="overlay">
  <article class="page project-detail">
    <header class="page-hero">
      <div class="page-hero__image"><img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" style={`object-position:${hero.position};`} /></div>
      <div class="page-hero__veil"></div>
      <div class="page-hero__content">
        <p class="eyebrow">Proyecto demo · {project.city}, {project.province}</p>
        <h1 class="display-xl">{project.name}</h1>
        <div class="page-hero__footer"><div class="tag-row"><span class="tag tag--light">{project.areaM2} m²</span><span class="tag tag--light">{statusLabel[project.status]}</span><span class="tag tag--light">{projectModel?.name ?? 'Modelo asociado'}</span></div><ActionLink href="/empezar/" label="Consultar un proyecto" variant="light" /></div>
      </div>
    </header>

    <section class="project-detail__intro section">
      <div class="contained project-detail__intro-grid">
        <div><p class="eyebrow">El escenario</p><h2 class="section-title">{project.intro}</h2></div>
        <dl class="project-detail__facts">{project.technicalNotes.map((note) => <div><dt>{note.label}</dt><dd>{note.value}</dd></div>)}</dl>
      </div>
    </section>

    <section class="project-detail__story section--surface">
      <div class="contained">
        <div class="project-detail__story-row"><figure class="media media--rounded"><img class="media__image" src={project.images[1].src} alt={project.images[1].alt} width="1536" height="1024" loading="lazy" style={`object-position:${project.images[1].position};`} /></figure><div><p class="eyebrow">Desafío</p><h2 class="media-title">{project.challenge}</h2><p class="body-copy">Un proyecto no se resuelve al sumar habitaciones. La relación entre acceso, reparo, orientación y rutina es la base para que las decisiones materiales tengan sentido.</p></div></div>
        <div class="project-detail__story-row project-detail__story-row--reverse"><div><p class="eyebrow">Respuesta</p><h2 class="media-title">{project.response}</h2><p class="body-copy">Las soluciones mostradas son ficticias y sirven como material de demostración. Lo importante es hacer visible una metodología de lectura y ajuste para cada situación territorial.</p></div><figure class="media media--rounded"><img class="media__image" src={project.images[2].src} alt={project.images[2].alt} width="1536" height="1024" loading="lazy" style={`object-position:${project.images[2].position};`} /></figure></div>
      </div>
    </section>

    <section class="project-detail__site-section section">
      <div class="contained project-detail__site-grid">
        <div><p class="eyebrow">Condiciones del sitio</p><h2 class="section-title">{project.city} pide una respuesta específica.</h2><p class="body-copy">Este bloque reemplaza la referencia cartográfica genérica por las condiciones que realmente orientan la propuesta: cómo se llega, qué clima se enfrenta y qué programa sostiene el lugar.</p></div>
        <dl class="project-detail__site-facts">{siteConditions.map((note) => <div><dt>{note.label}</dt><dd>{note.value}</dd></div>)}</dl>
      </div>
    </section>

    <nav class="project-detail__pager section--leaf" aria-label="Navegar entre proyectos">
      <div class="contained project-detail__pager-grid">
        <a href={`/proyectos/${previousProject.slug}/`} class="project-detail__pager-link">
          <span class="eyebrow">Anterior</span>
          <strong>{previousProject.name}</strong>
          <span aria-hidden="true">← Ver proyecto</span>
        </a>
        <a href="/proyectos/" class="project-detail__pager-index"><span class="eyebrow">Todos los proyectos</span><span aria-hidden="true">↗</span></a>
        <a href={`/proyectos/${nextProject.slug}/`} class="project-detail__pager-link project-detail__pager-link--next">
          <span class="eyebrow">Siguiente</span>
          <strong>{nextProject.name}</strong>
          <span aria-hidden="true">Ver proyecto →</span>
        </a>
      </div>
    </nav>

  </article>
</BaseLayout>

<style>
  .project-detail__intro { padding-block: clamp(5rem, 10vw, 11rem); }
  .project-detail__intro-grid { display: grid; grid-template-columns: 1.15fr .65fr; gap: clamp(2rem, 8vw, 10rem); align-items: end; }
  .project-detail__intro-grid .eyebrow { margin-bottom: 1rem; }
  .project-detail__facts { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .project-detail__facts div { padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .project-detail__facts dt { color: var(--forest); font-size: .65rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .project-detail__facts dd { margin: .48rem 0 0; font-family: var(--display); font-size: 1.55rem; line-height: 1.04; letter-spacing: -.045em; }
  .project-detail__story { padding-block: clamp(4.5rem, 9vw, 10rem); }
  .project-detail__story-row { display: grid; grid-template-columns: 1.04fr .68fr; gap: clamp(2rem, 8vw, 10rem); align-items: center; }
  .project-detail__story-row + .project-detail__story-row { margin-top: clamp(5rem, 12vw, 13rem); }
  .project-detail__story-row figure { aspect-ratio: 1.16 / 1; }
  .project-detail__story-row .eyebrow { margin-bottom: .9rem; }
  .project-detail__story-row .body-copy { margin-top: 1.4rem; }
  .project-detail__site-section { padding-block: clamp(5rem, 10vw, 11rem); background: var(--surface); }
  .project-detail__site-grid { display: grid; grid-template-columns: .78fr 1fr; gap: clamp(2rem, 7vw, 9rem); align-items: start; }
  .project-detail__site-grid .eyebrow { margin-bottom: .9rem; }
  .project-detail__site-grid .body-copy { margin-top: 1.4rem; }
  .project-detail__site-facts { display: grid; border-top: 1px solid var(--line); }
  .project-detail__site-facts div { display: grid; grid-template-columns: .45fr 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .project-detail__site-facts dt { color: var(--forest); font-size: .65rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .project-detail__site-facts dd { margin: 0; font-family: var(--display); font-size: 1.45rem; line-height: 1.05; letter-spacing: -.045em; }
  .project-detail__pager { padding-block: clamp(2.5rem, 5vw, 5rem); }
  .project-detail__pager-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; align-items: end; }
  .project-detail__pager-link { display: grid; gap: .55rem; max-width: 18rem; }
  .project-detail__pager-link .eyebrow { color: var(--forest); }
  .project-detail__pager-link strong { font-family: var(--display); font-size: clamp(1.8rem, 3vw, 3.15rem); font-weight: 400; line-height: .95; letter-spacing: -.055em; }
  .project-detail__pager-link > span:last-child { font-size: .68rem; font-weight: 750; letter-spacing: .05em; text-transform: uppercase; }
  .project-detail__pager-link--next { justify-self: end; text-align: right; }
  .project-detail__pager-index { display: inline-flex; align-items: center; gap: .7rem; font-size: .68rem; font-weight: 750; letter-spacing: .05em; text-transform: uppercase; }
  .project-detail__pager-index > span:last-child { display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border: 1px solid currentColor; border-radius: 50%; }
  @media (max-width: 900px) { .project-detail__intro-grid, .project-detail__story-row, .project-detail__site-grid { grid-template-columns: 1fr; } .project-detail__story-row--reverse > :first-child { order: 2; } .project-detail__pager-grid { grid-template-columns: 1fr 1fr; } .project-detail__pager-index { grid-column: 1 / -1; grid-row: 1; } .project-detail__pager-link--next { justify-self: end; } }
  @media (max-width: 560px) { .project-detail__site-facts div { grid-template-columns: 1fr; gap: .4rem; } }
</style>
