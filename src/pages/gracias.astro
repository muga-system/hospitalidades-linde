---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/global/ActionLink.astro';
---

<BaseLayout title="Gracias — LINDE" description="Confirmación de la consulta demo LINDE." noHeader noFooter>
  <main class="thanks-page">
    <a class="thanks-page__brand" href="/">LINDE</a>
    <div class="thanks-page__content"><p class="eyebrow">Consulta demo completada</p><h1 class="display-xl">Gracias por contar un poco de tu proyecto.</h1><p class="body-large">En esta demo no se envió ni se guardó información. En una versión real, este sería el paso de confirmación y próxima conversación.</p><div><ActionLink href="/" label="Volver al inicio" variant="solid" /><ActionLink href="/proyectos/" label="Explorar proyectos" /></div></div>
  </main>
</BaseLayout>

<style>
  .thanks-page { position: relative; min-height: 100svh; display: flex; flex-direction: column; padding: clamp(1.3rem, 3vw, 3.2rem) var(--gutter); overflow: hidden; color: var(--white); background: var(--forest); }
  .thanks-page__brand { font-family: var(--display); font-size: 2rem; line-height: 1; letter-spacing: -.08em; }
  .thanks-page__content { max-width: 72rem; margin: auto 0; }
  .thanks-page__content .eyebrow { color: var(--leaf); margin-bottom: 1rem; }
  .thanks-page__content h1 { max-width: 12ch; }
  .thanks-page__content .body-large { margin-top: 2rem; }
  .thanks-page__content > div { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
</style>
