---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/global/ActionLink.astro';
import ModelCard from '../components/catalog/ModelCard.astro';
import SolutionEntry from '../components/home/SolutionEntry.astro';
import SectionIntro from '../components/global/SectionIntro.astro';
import { featuredModels, homeSolutions, projects, site } from '../data/content';

const featureProject = projects[1];
---

<BaseLayout headerMode="overlay">
  <div class="page page--home">
    <section class="home-hero" aria-labelledby="hero-title">
      <video class="home-hero__video" autoplay muted loop playsinline preload="metadata" poster="/images/home/hero-linde.webp" aria-hidden="true">
        <source src="/video/hero-motion.mp4" type="video/mp4" />
      </video>
      <img class="home-hero__image" src="/images/home/hero-linde.webp" alt="" width="1536" height="1024" fetchpriority="high" />
      <div class="home-hero__veil"></div>
      <div class="home-hero__content">
        <p class="eyebrow">Arquitectura + desarrollo</p>
        <h1 id="hero-title" class="display-xl">{site.heroTitle}</h1>
        <p class="home-hero__summary">{site.heroSummary}</p>
        <div class="home-hero__actions">
          <ActionLink href={site.primaryCta.href} label={site.primaryCta.label} variant="hero" />
        </div>
      </div>
      <p class="home-hero__location meta">Patagonia, Argentina <span>·</span> Demo comercial</p>
    </section>

    <section class="section home-solutions" aria-labelledby="soluciones-title">
      <div class="contained">
        <SectionIntro eyebrow="01 · Soluciones" title="¿Qué querés construir?" copy="Un punto de partida para ordenar una situación concreta antes de llegar a un modelo o a una forma." href="/soluciones/" action="Ver todas las soluciones" centered />
      </div>
      <div class="horizontal-scroll-scene" data-horizontal-scene>
        <div class="horizontal-scroll-scene__sticky">
          <div class="horizontal-scroll-scene__viewport" data-horizontal-viewport role="region" aria-label="Soluciones de LINDE">
            <div class="home-solutions__rail" data-horizontal-rail>
              {homeSolutions.map((solution, index) => <SolutionEntry solution={solution} index={index} />)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="process-strip section--dark" aria-labelledby="proceso-title">
      <div class="contained">
        <div class="process-strip__head">
          <p class="eyebrow">02 · Cómo trabajamos</p>
          <h2 id="proceso-title" class="section-title">Una secuencia clara para decisiones que no se resuelven de una vez.</h2>
          <ActionLink href="/proceso/" label="Conocer el proceso" variant="light" />
        </div>
        <ol class="process-strip__steps">
          {['Leer el lugar', 'Definir programa y números', 'Diseñar y documentar', 'Coordinar la ejecución'].map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong><i aria-hidden="true">↘</i></li>)}
        </ol>
      </div>
    </section>

    <section class="section models-home" aria-labelledby="modelos-title">
      <div class="contained">
          <SectionIntro eyebrow="03 · Modelos" title="Puntos de partida, no respuestas cerradas." copy="Seis configuraciones base para conversar con más precisión sobre escala, usos y posibilidades del sitio." href="/modelos/" action="Ver todos los modelos" />
      </div>
      <div class="horizontal-scroll-scene" data-horizontal-scene>
        <div class="horizontal-scroll-scene__sticky">
          <div class="horizontal-scroll-scene__viewport" data-horizontal-viewport role="region" aria-label="Modelos destacados de LINDE">
            <div class="models-home__rail" data-horizontal-rail>
              {featuredModels.map((model, index) => <div class="models-home__item"><ModelCard model={model} index={index} size="featured" /></div>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="feature-project" aria-labelledby="destacado-title">
      <div class="feature-project__media media"><img class="media__image" src={featureProject.images[0].src} alt={featureProject.images[0].alt} width="1536" height="1024" loading="lazy" style={`object-position:${featureProject.images[0].position};`} /><div class="feature-project__veil"></div></div>
      <div class="feature-project__content" data-reveal>
        <p class="eyebrow">04 · Proyecto destacado · {featureProject.city}</p>
        <h2 id="destacado-title" class="display-l">{featureProject.name}</h2>
        <p>{featureProject.intro}</p>
        <div class="tag-row"><span class="tag tag--light">{featureProject.areaM2} m²</span><span class="tag tag--light">{featureProject.modelSlugs[0].replace('-', ' ')}</span><span class="tag tag--light">{featureProject.status} · demo</span></div>
        <ActionLink href={`/proyectos/${featureProject.slug}/`} label="Ver proyecto" variant="light" />
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  import { initHorizontalRails } from '../scripts/horizontal-rails';

  initHorizontalRails();
</script>

<style>
  .page--home { overflow: visible; }
  .home-hero { position: relative; min-height: 100svh; display: grid; place-items: center; isolation: isolate; color: var(--white); background: var(--forest); text-align: center; }
  .home-hero__image, .home-hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 72% center; }
  .home-hero__image { z-index: -3; }
  .home-hero__video { z-index: -2; }
  .home-hero__veil, .feature-project__veil { position: absolute; z-index: -1; inset: 0; background: rgba(9, 17, 9, .43); }
  .home-hero__content { width: min(100% - 3rem, 82rem); padding-top: var(--header-height); }
  .home-hero__content .eyebrow { margin-bottom: 1.35rem; }
  .home-hero__content h1 { max-width: 12ch; margin-inline: auto; }
  .home-hero__summary { max-width: 38rem; margin: 1.9rem auto 0; font-size: clamp(1rem, 1.45vw, 1.3rem); line-height: 1.45; }
  .home-hero__actions { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 2rem; }
  .home-hero__location { position: absolute; left: var(--gutter); bottom: 1.7rem; }
  .home-hero__location span { padding-inline: .4rem; color: var(--leaf); }
  .home-solutions { overflow: visible; }
  .horizontal-scroll-scene { position: relative; margin-top: clamp(2.2rem, 5vw, 5.2rem); }
  .horizontal-scroll-scene__sticky { display: flex; align-items: center; width: 100%; }
  .horizontal-scroll-scene__viewport { width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; scroll-snap-type: x proximity; scrollbar-width: thin; scrollbar-color: rgba(25, 32, 23, .32) transparent; }
  .horizontal-scroll-scene__viewport::-webkit-scrollbar { height: .28rem; }
  .horizontal-scroll-scene__viewport::-webkit-scrollbar-thumb { border-radius: 999px; background: rgba(25, 32, 23, .32); }
  .horizontal-scroll-scene__viewport::-webkit-scrollbar-track { background: transparent; }
  .horizontal-scroll-scene__viewport > * > * { scroll-snap-align: start; }
  .home-solutions__rail { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(19rem, 29vw); align-items: start; gap: clamp(1rem, 2.5vw, 2.6rem); width: max-content; padding: .2rem max(var(--gutter), calc((100vw - 1730px) / 2)); }
  .process-strip { padding-block: clamp(4rem, 7vw, 7.5rem); }
  .process-strip__head { display: grid; grid-template-columns: .3fr 1fr auto; gap: 2rem; align-items: end; }
  .process-strip__head .eyebrow { color: var(--moss); }
  .process-strip__steps { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: clamp(3rem, 6vw, 6rem); list-style: none; border-top: 1px solid rgba(248,245,236,.35); }
  .process-strip__steps li { min-height: 13rem; display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; padding: 1rem 1rem 1rem 0; border-right: 1px solid rgba(248,245,236,.28); }
  .process-strip__steps li + li { padding-left: 1rem; }
  .process-strip__steps span { color: var(--moss); font-size: .69rem; font-weight: 700; letter-spacing: .08em; }
  .process-strip__steps strong { max-width: 9ch; font-family: var(--display); font-size: clamp(1.8rem, 2.7vw, 3rem); font-weight: 400; line-height: .96; letter-spacing: -.055em; }
  .process-strip__steps i { color: var(--leaf); font-size: 1.35rem; font-style: normal; }
  .models-home { overflow: visible; }
  .models-home__rail { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(24rem, 39vw); gap: clamp(1rem, 2.3vw, 2.7rem); width: max-content; padding: 0 max(var(--gutter), calc((100vw - 1730px) / 2)); }
  .feature-project { position: relative; min-height: 57rem; display: flex; align-items: end; isolation: isolate; color: var(--white); }
  .feature-project__media { position: absolute; z-index: -2; inset: 0; }
  .feature-project__media img { width: 100%; height: 100%; object-fit: cover; object-position: 28% center; }
  .feature-project__content { width: min(100% - var(--gutter) * 2, 1730px); margin: 0 auto; padding-bottom: clamp(3.5rem, 7vw, 7rem); }
  .feature-project__content .eyebrow { margin-bottom: .8rem; }
  .feature-project__content .display-l { max-width: 8ch; }
  .feature-project__content > p:not(.eyebrow) { max-width: 37rem; margin: 1.3rem 0; font-size: 1.02rem; line-height: 1.55; }
  .feature-project__content .action-link { margin-top: 1.65rem; }
  @media (min-width: 901px) { .horizontal-scroll-scene.is-enhanced .horizontal-scroll-scene__sticky { position: sticky; top: var(--header-height); height: calc(100svh - var(--header-height)); overflow: hidden; } .horizontal-scroll-scene.is-enhanced .horizontal-scroll-scene__viewport { overflow: hidden; scroll-snap-type: none; } .horizontal-scroll-scene.is-enhanced [data-horizontal-rail] { will-change: transform; } }
  @media (max-width: 900px) { .home-solutions__rail { grid-auto-columns: minmax(17rem, 62vw); } .process-strip__head { grid-template-columns: 1fr; gap: 1.2rem; } .process-strip__steps { grid-template-columns: repeat(2, 1fr); } .process-strip__steps li:nth-child(2) { border-right: 0; } .models-home__rail { grid-auto-columns: minmax(22rem, 72vw); } .feature-project { min-height: 48rem; } }
  @media (max-width: 560px) { .home-hero { min-height: 92svh; } .home-hero__image, .home-hero__video { object-position: 66% center; } .home-hero__content { width: min(100% - 2.5rem, 35rem); } .home-hero__summary { font-size: .94rem; } .home-hero__actions { flex-direction: column; } .home-hero__location { left: 1.25rem; bottom: 1.25rem; } .home-solutions__rail { grid-auto-columns: minmax(17rem, 82vw); padding-left: 1.25rem; } .process-strip__steps { grid-template-columns: 1fr; } .process-strip__steps li, .process-strip__steps li + li { min-height: 9.8rem; padding: 1rem 0; border-right: 0; border-bottom: 1px solid rgba(248,245,236,.28); } .models-home__rail { grid-auto-columns: 82vw; padding-left: 1.25rem; } .feature-project { min-height: 42rem; } .feature-project__content { width: calc(100% - 2.5rem); } }
  @media (prefers-reduced-motion: reduce) { .home-hero__video { display: none; } }
</style>
