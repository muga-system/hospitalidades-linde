---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/global/ActionLink.astro';

const services = [
  ['Lectura y viabilidad', 'Para saber qué conviene hacer antes de comprometer una arquitectura.', 'Lectura inicial del sitio', 'Programa y superficies', 'Etapas y criterio de inversión'],
  ['Proyecto de arquitectura', 'Para llevar una idea ordenada a una propuesta espacial, técnica y sensible al lugar.', 'Implantación y anteproyecto', 'Proyecto ejecutivo', 'Coordinación con especialistas'],
  ['Hospitalidad de pequeña escala', 'Para pensar unidades, recorridos y operación como una experiencia completa.', 'Masterplan de baja escala', 'Unidades y espacios comunes', 'Lógica operativa y etapas'],
  ['Acompañamiento de obra', 'Para sostener la relación entre la intención del proyecto y las decisiones de ejecución.', 'Documentación de decisiones', 'Coordinación de equipos', 'Ajustes de detalle en obra'],
];
---

<BaseLayout title="Servicios — LINDE" description="Alcances de LINDE para arquitectura, territorio y hospitalidad de pequeña escala.">
  <div class="page services-page">
    <header class="article-head"><div class="contained article-head__grid"><div><p class="eyebrow">Servicios</p><h1 class="page-title">Alcances que se ajustan a la pregunta, no al revés.</h1></div><div class="article-head__intro"><p class="body-copy">No todas las situaciones piden el mismo acompañamiento. A veces hace falta leer un lote; otras, coordinar una obra. El alcance se construye según el momento del proyecto.</p></div></div></header>
    <section class="services-page__image"><figure class="media"><img class="media__image" src="/images/library/threshold-linde.png" alt="Terraza de madera de un refugio LINDE frente a un bosque." width="1536" height="1024" fetchpriority="high" /></figure></section>
    <section class="section"><div class="contained services-page__list">{services.map(([title, summary, ...items], index) => <article><div class="services-page__index">{String(index + 1).padStart(2, '0')}</div><div><h2>{title}</h2><p>{summary}</p></div><ul>{items.map((item) => <li>{item}<span aria-hidden="true">↗</span></li>)}</ul></article>)}</div></section>
    <section class="services-page__callout section--leaf"><div class="contained services-page__callout-grid"><div><p class="eyebrow">Un alcance posible</p><h2 class="section-title">Empezar por definir el problema también es parte del servicio.</h2></div><div><p class="body-copy">Si todavía no sabés qué servicio corresponde, el formulario guiado está pensado justamente para llegar a una primera conversación con más contexto.</p><ActionLink href="/empezar/" label="Contanos la situación" /></div></div></section>
  </div>
</BaseLayout>

<style>
  .services-page__image figure { height: min(67svh, 780px); }
  .services-page__image img { object-position: 58% center; }
  .services-page__list { border-top: 1px solid var(--line); }
  .services-page__list article { display: grid; grid-template-columns: .12fr .95fr .68fr; gap: clamp(1.2rem, 5vw, 6rem); padding-block: clamp(2.5rem, 5.5vw, 6rem); border-bottom: 1px solid var(--line); }
  .services-page__index { color: var(--forest); font-size: .68rem; font-weight: 750; }
  .services-page__list h2 { max-width: 12ch; font-family: var(--display); font-size: clamp(2.5rem, 5vw, 5.3rem); font-weight: 400; line-height: .9; letter-spacing: -.065em; }
  .services-page__list p { max-width: 42ch; margin-top: 1rem; font-size: .84rem; line-height: 1.55; }
  .services-page__list ul { align-self: end; list-style: none; }
  .services-page__list li { display: flex; justify-content: space-between; gap: 1rem; padding: .72rem 0; border-top: 1px solid var(--line); font-size: .74rem; font-weight: 650; }
  .services-page__list li:last-child { border-bottom: 1px solid var(--line); }
  .services-page__list li span { color: var(--earth); }
  .services-page__callout { padding-block: clamp(4rem, 8vw, 8rem); }
  .services-page__callout-grid { display: grid; grid-template-columns: 1.08fr .65fr; gap: clamp(2rem, 7vw, 9rem); }
  .services-page__callout .eyebrow { margin-bottom: 1rem; }
  .services-page__callout .action-link { margin-top: 1.6rem; }
  @media (max-width: 800px) { .services-page__list article, .services-page__callout-grid { grid-template-columns: 1fr; } .services-page__list article { gap: 1.2rem; } }
</style>
