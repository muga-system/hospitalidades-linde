---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModelCard from '../../components/catalog/ModelCard.astro';
import ActionLink from '../../components/global/ActionLink.astro';
import TopographicMark from '../../components/global/TopographicMark.astro';
import { models } from '../../data/content';
---

<BaseLayout title="Modelos — LINDE" description="Seis puntos de partida de arquitectura demo para conversar sobre escala, usos y sitio.">
  <div class="page models-index">
    <header class="article-head">
      <div class="contained article-head__grid">
        <div><p class="eyebrow">Modelos LINDE · 06 configuraciones</p><h1 class="page-title">Puntos de partida para hacer mejores preguntas.</h1></div>
        <div class="article-head__intro"><p class="body-copy">No son productos cerrados. Son arquitecturas base que permiten hablar de programa, metros, orientación y posibilidades del terreno con algo concreto sobre la mesa.</p><div style="margin-top:1.45rem"><ActionLink href="/empezar/" label="Contanos tu idea" /></div></div>
      </div>
    </header>
    <section class="models-index__intro section--leaf">
      <div class="contained models-index__intro-grid"><TopographicMark /><p class="body-large">Cada modelo admite transformaciones: cambia su implantación, sus aberturas, el modo de crecer o el vínculo con otras piezas del conjunto.</p><p class="meta">Contenido demostrativo<br />No corresponde a un producto constructivo real.</p></div>
    </section>
    <section class="section">
      <div class="contained">
        <div class="models-index__bar"><p class="eyebrow">Todos los modelos</p><p class="meta">06 modelos · superficies entre 38 y 156 m²</p></div>
        <div class="model-grid">{models.map((model, index) => <ModelCard model={model} index={index} />)}</div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .models-index__intro { padding-block: clamp(3.5rem, 7vw, 7rem); }
  .models-index__intro-grid { display: grid; grid-template-columns: .38fr .9fr .35fr; gap: 2rem; align-items: end; }
  .models-index__intro-grid .body-large { max-width: 25ch; }
  .models-index__bar { display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; margin-bottom: 2rem; border-bottom: 1px solid var(--line); }
  @media (max-width: 800px) { .models-index__intro-grid { grid-template-columns: 1fr; } .models-index__intro-grid .topo-mark { width: 13rem; } }
  @media (max-width: 560px) { .models-index__bar { align-items: flex-start; flex-direction: column; gap: .5rem; } }
</style>
