---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActionLink from '../../components/global/ActionLink.astro';
import ModelCard from '../../components/catalog/ModelCard.astro';
import { formatBedrooms, models } from '../../data/content';
import type { Model } from '../../data/types';

export function getStaticPaths() {
  return models.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model } = Astro.props as { model: Model };
const otherModels = models.filter((item) => item.slug !== model.slug).slice(0, 3);
const hero = model.images[0];
const planSectionMedia = model.images[0];
---

<BaseLayout title={`${model.name} — Modelos LINDE`} description={model.summary} image={hero.src} headerMode="overlay">
  <article class="page model-detail">
    <header class="page-hero">
      <div class="page-hero__image"><img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" style={`object-position:${hero.position};`} /></div>
      <div class="page-hero__veil"></div>
      <div class="page-hero__content">
        <p class="eyebrow">Modelo base · {model.areaM2} m²</p>
        <h1 class="display-xl">{model.name}</h1>
        <div class="page-hero__footer"><div class="tag-row"><span class="tag tag--light">{formatBedrooms(model.bedrooms)}</span><span class="tag tag--light">{model.bathrooms} baño{model.bathrooms > 1 ? 's' : ''}</span>{model.flexibleSpace && <span class="tag tag--light">Espacio flexible</span>}</div><ActionLink href="/empezar/" label="Contanos tu proyecto" variant="hero" /></div>
      </div>
    </header>

    <section class="model-detail__overview section">
      <div class="contained model-detail__overview-grid">
        <div><p class="eyebrow">Una base abierta</p><h2 class="section-title">{model.tagline}</h2></div>
        <div><p class="body-large">{model.summary}</p><p class="model-detail__note">Este modelo es una pieza demostrativa. El proyecto real parte de una conversación sobre sitio, programa, presupuesto y tiempos.</p></div>
        <dl class="model-detail__facts"><div><dt>Superficie base</dt><dd>{model.areaM2} m²</dd></div><div><dt>Programa</dt><dd>{formatBedrooms(model.bedrooms)} · {model.bathrooms} baño{model.bathrooms > 1 ? 's' : ''}</dd></div><div><dt>Flexible</dt><dd>{model.flexibleSpace ? 'Sí, según uso' : 'No necesario'}</dd></div><div><dt>Estado</dt><dd>Modelo demo</dd></div></dl>
      </div>
    </section>

    <section class="model-detail__features section--surface">
      <div class="contained"><p class="eyebrow">Claves del modelo</p><ol>{model.features.map((feature, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{feature}</p><i aria-hidden="true">↗</i></li>)}</ol></div>
    </section>

    <section class="model-detail__plan section">
      <div class="contained model-detail__plan-grid">
        <figure class="model-detail__plan-media"><img src={planSectionMedia.src} alt={`Maqueta principal del modelo ${model.name}.`} width={planSectionMedia.width} height={planSectionMedia.height} loading="lazy" style={`object-position:${planSectionMedia.position ?? 'center'};`} /></figure>
        <div><p class="eyebrow">Maqueta conceptual</p><h2 class="section-title">Una organización que deja lugar para adaptarse.</h2><p class="body-copy">La maqueta permite leer cómo se relacionan los ambientes, las expansiones y el exterior antes de definir una arquitectura específica.</p><div class="model-detail__recommended"><p class="meta">Puede servir como base para</p>{model.recommendedFor.map((item) => <span class="tag tag--soft">{item.replace('-', ' ')}</span>)}</div></div>
      </div>
    </section>

    <section class="model-detail__gallery" aria-label={`Imágenes de ${model.name}`}>
      <figure class="model-detail__gallery-primary media"><img class="media__image" src={model.images[1].src} alt={model.images[1].alt} width="1536" height="1024" loading="lazy" style={`object-position:${model.images[1].position};`} /></figure>
      <div class="contained model-detail__gallery-sub"><figure class="media media--rounded"><img class="media__image" src={model.images[2].src} alt={model.images[2].alt} width="1536" height="1024" loading="lazy" style={`object-position:${model.images[2].position};`} /></figure><p class="body-large">La escala no define la intensidad de una experiencia. Una superficie contenida puede construir relaciones amplias con el exterior si las decisiones se coordinan desde el comienzo.</p></div>
    </section>

    <section class="section--leaf model-detail__next"><div class="contained"><div class="section-head"><div><p class="eyebrow">Otros modelos</p><h2 class="section-title">Cada punto de partida se mueve con el sitio.</h2></div><ActionLink href="/modelos/" label="Ver catálogo" variant="hero" /></div><div class="model-detail__other-models">{otherModels.map((item, index) => <ModelCard model={item} index={index} />)}</div></div></section>
  </article>
</BaseLayout>

<style>
  .model-detail__overview { padding-block: clamp(5rem, 10vw, 11rem); }
  .model-detail__overview-grid { display: grid; grid-template-columns: 1.02fr .72fr; gap: clamp(2rem, 7vw, 9rem); }
  .model-detail__overview-grid .eyebrow { margin-bottom: 1.1rem; }
  .model-detail__note { margin-top: 2rem; max-width: 44ch; color: rgba(25,32,23,.7); font-size: .76rem; line-height: 1.5; }
  .model-detail__facts { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 3rem; border-top: 1px solid var(--line); }
  .model-detail__facts div { padding: 1rem 1rem 0 0; border-right: 1px solid var(--line); }
  .model-detail__facts div + div { padding-left: 1rem; }
  .model-detail__facts dt { color: var(--forest); font-size: .65rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .model-detail__facts dd { margin: .65rem 0 0; font-family: var(--display); font-size: 1.6rem; line-height: 1; letter-spacing: -.05em; }
  .model-detail__features { padding-block: clamp(4rem, 8vw, 8rem); }
  .model-detail__features .eyebrow { margin-bottom: 2.1rem; }
  .model-detail__features ol { list-style: none; border-top: 1px solid var(--line); }
  .model-detail__features li { display: grid; grid-template-columns: 11% 1fr auto; gap: 1rem; align-items: center; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .model-detail__features span { color: var(--forest); font-size: .67rem; font-weight: 700; }
  .model-detail__features p { font-family: var(--display); font-size: clamp(2rem, 4vw, 4.2rem); line-height: .96; letter-spacing: -.06em; }
  .model-detail__features i { font-size: 1.5rem; font-style: normal; }
  .model-detail__plan { padding-block: clamp(4.8rem, 9vw, 10rem); }
  .model-detail__plan-grid { display: grid; grid-template-columns: 1.1fr .72fr; gap: clamp(2rem, 6vw, 8rem); align-items: center; }
  .model-detail__plan-media { aspect-ratio: 3 / 2; overflow: hidden; border-radius: var(--radius-media); background: var(--surface); }
  .model-detail__plan-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .model-detail__plan-grid .eyebrow { margin-bottom: 1rem; }
  .model-detail__plan-grid .body-copy { margin-top: 1.5rem; }
  .model-detail__recommended { display: flex; align-items: center; flex-wrap: wrap; gap: .55rem; margin-top: 1.8rem; }
  .model-detail__recommended .meta { width: 100%; margin-bottom: .15rem; }
  .model-detail__gallery-primary { aspect-ratio: 3 / 2; background: var(--surface); }
  .model-detail__gallery-sub { display: grid; grid-template-columns: .72fr .45fr; gap: clamp(2rem, 7vw, 9rem); align-items: center; padding-block: clamp(3rem, 7vw, 8rem); }
  .model-detail__gallery-sub figure { aspect-ratio: 3 / 2; background: var(--surface); }
  .model-detail__gallery .media__image { object-fit: contain; transform: none; }
  .model-detail__other-models { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 2rem); }
  .model-detail__next { padding-block: clamp(4rem, 8vw, 8rem); }
  @media (max-width: 900px) { .model-detail__overview-grid, .model-detail__plan-grid, .model-detail__gallery-sub { grid-template-columns: 1fr; } .model-detail__facts { grid-template-columns: repeat(2, 1fr); } .model-detail__other-models { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .model-detail__facts { grid-template-columns: 1fr; } .model-detail__facts div, .model-detail__facts div + div { padding: 1rem 0; border-right: 0; border-bottom: 1px solid var(--line); } .model-detail__features li { grid-template-columns: 2rem 1fr; } .model-detail__features i { display: none; } .model-detail__other-models { grid-template-columns: 1fr; } }
</style>
