---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ActionLink from "../../components/global/ActionLink.astro";
import {
  featuredProjects,
  homeSolutionDetails,
  relatedModels,
  relatedProjects,
  solutions,
  statusLabel,
} from "../../data/content";
import type { Media, Solution } from "../../data/types";

export function getStaticPaths() {
  const solutionPages = [
    ...homeSolutionDetails,
    ...solutions.filter(
      (solution) =>
        !homeSolutionDetails.some((detail) => detail.slug === solution.slug),
    ),
  ];

  return solutionPages.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

const { solution } = Astro.props as { solution: Solution };
const linkedModels = relatedModels(solution.modelSlugs);
const linkedProjects = relatedProjects(solution.projectSlugs);
const projectSequence = [
  ...linkedProjects,
  ...featuredProjects.filter(
    (project) => !linkedProjects.some((item) => item.slug === project.slug),
  ),
].slice(0, 3);
const displayTitle = solution.title;
const homeOrderIndex = homeSolutionDetails.findIndex(
  (detail) => detail.slug === solution.slug,
);
const broadOrderIndex = solutions.findIndex(
  (entry) => entry.slug === solution.slug,
);
const solutionNumber =
  homeOrderIndex >= 0 ? homeOrderIndex + 1 : broadOrderIndex + 1;
const heroMedia = solution.image;
const fallbackMedia: Media = {
  src: "/images/library/threshold-linde.png",
  alt: "Galería protegida de LINDE en relación con el paisaje.",
  width: 1536,
  height: 1024,
};
const decisionMedia = projectSequence[0]?.images[1] ?? fallbackMedia;
---

<BaseLayout
  title={`${displayTitle} — LINDE`}
  description={solution.summary}
  image={heroMedia.src}
>
  <article class="page solution-detail solution-detail--compact">
    <header class="solution-detail__hero" aria-labelledby="solution-title">
      <div class="contained solution-detail__hero-inner">
        <figure
          class="solution-detail__hero-art solution-detail__hero-art--transparent"
          data-reveal
        >
          <img
            src={heroMedia.src}
            alt={heroMedia.alt}
            width={heroMedia.width}
            height={heroMedia.height}
            fetchpriority="high"
            transition:name={`solution-art-${solution.slug}`}
          />
        </figure>
        <div class="solution-detail__hero-copy" data-reveal>
          <p class="eyebrow">
            Solución LINDE · {String(solutionNumber).padStart(2, "0")}
          </p>
          <h1 id="solution-title" class="display-xl">{displayTitle}</h1>
          <p class="solution-detail__hero-summary">{solution.summary}</p>
          <div class="solution-detail__hero-cta">
            <ActionLink
              href="/empezar/"
              label="Contanos tu proyecto"
              variant="solid"
            />
          </div>
        </div>
      </div>
    </header>

    <section
      class="solution-detail__compact-decisions"
      aria-labelledby="compact-decisions-title"
    >
      <div class="contained solution-detail__compact-decisions-grid">
        <figure
          class="solution-detail__compact-media media media--rounded"
          data-reveal
        >
          <img
            class="media__image"
            src={decisionMedia.src}
            alt={decisionMedia.alt}
            width={decisionMedia.width}
            height={decisionMedia.height}
            loading="lazy"
            style={`object-position:${decisionMedia.position ?? "center"};`}
          />
        </figure>
        <div class="solution-detail__compact-decisions-copy" data-reveal>
          <p class="eyebrow">Lo que ordena el proyecto</p>
          <h2 id="compact-decisions-title" class="section-title">
            Tres decisiones antes de definir la forma.
          </h2>
          <ol>
            {solution.considerations.map((item, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    {
      projectSequence.length > 0 && (
        <section
          class="solution-detail__projects"
          aria-labelledby="projects-title"
        >
          <div class="contained solution-detail__projects-intro">
            <p class="eyebrow">Proyectos en territorio</p>
            <h2 id="projects-title" class="section-title">
              Una situación concreta para imaginar lo posible.
            </h2>
          </div>
          <div
            class="solution-detail__photo-sequence solution-detail__photo-sequence--reel"
            data-project-reel
            style={`--reel-count:${projectSequence.length};`}
          >
            <div class="solution-detail__photo-stage">
              {projectSequence.map((project, index) => {
                const backgroundIndex =
                  index % Math.min(project.images.length, 2);
                const detailIndex = backgroundIndex === 0 ? 1 : 0;
                const media = project.images[backgroundIndex];
                const detailMedia =
                  project.images[detailIndex] ?? project.images[0];
                const reelStyle = `--reel-stack:${projectSequence.length - index};--reel-scene-y:${index === 0 ? "0px" : "100svh"};--reel-media-y:0px;--reel-content-y:0px;--reel-content-opacity:1;`;
                return (
                  <a
                    class="solution-detail__photo-panel"
                    href={`/proyectos/${project.slug}/`}
                    data-reel-panel
                    style={reelStyle}
                  >
                    <figure class="solution-detail__photo-background">
                      <img
                        src={media.src}
                        alt=""
                        width={media.width}
                        height={media.height}
                        loading={index === 0 ? "eager" : "lazy"}
                        style={`object-position:${media.position ?? "center"};`}
                      />
                    </figure>
                    <span
                      class="solution-detail__photo-veil"
                      aria-hidden="true"
                    />
                    <span class="solution-detail__photo-sticky">
                      <span class="solution-detail__photo-content">
                        <strong>{project.name}</strong>
                        <span class="tag-row">
                          <span class="tag tag--light">{project.city}</span>
                          <span class="tag tag--light">
                            {project.areaM2} m²
                          </span>
                          {project.bedrooms !== undefined && (
                            <span class="tag tag--light">
                              {project.bedrooms === 0
                                ? "Estudio"
                                : `${project.bedrooms} dorm.`}
                            </span>
                          )}
                          {project.bathrooms !== undefined && (
                            <span class="tag tag--light">
                              {project.bathrooms}{" "}
                              {project.bathrooms === 1 ? "baño" : "baños"}
                            </span>
                          )}
                          <span class="tag tag--light">
                            {statusLabel[project.status]}
                          </span>
                        </span>
                      </span>
                      <figure class="solution-detail__photo-detail media media--rounded">
                        <img
                          class="media__image"
                          src={detailMedia.src}
                          alt={detailMedia.alt}
                          width={detailMedia.width}
                          height={detailMedia.height}
                          loading="lazy"
                          style={`object-position:${detailMedia.position ?? "center"};`}
                        />
                      </figure>
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      )
    }

    {
      linkedModels.length > 0 && (
        <section
          class="solution-detail__compact-end"
          aria-labelledby="compact-models-title"
        >
          <div class="contained solution-detail__compact-end-grid">
            <div>
              <p class="eyebrow">Modelos relacionados</p>
              <h2 id="compact-models-title" class="section-title">
                Puntos de partida, sin cerrar la conversación.
              </h2>
              <div class="solution-detail__compact-model-links">
                {linkedModels.map((model) => (
                  <a href={`/modelos/${model.slug}/`}>
                    <strong>{model.name}</strong>
                    <span>
                      {model.areaM2} m² ·{" "}
                      {model.bedrooms === "studio"
                        ? "Estudio"
                        : `${model.bedrooms} dorm.`}{" "}
                      ↗
                    </span>
                  </a>
                ))}
              </div>
            </div>
            <aside class="solution-detail__compact-cta">
              <p class="eyebrow">Siguiente paso</p>
              <h2>Veamos qué puede sumar tu terreno.</h2>
              <p>
                Una primera conversación alcanza para ordenar el punto de
                partida y reconocer las decisiones importantes.
              </p>
              <ActionLink
                href="/empezar/"
                label="Contanos tu proyecto"
                variant="solid"
              />
            </aside>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<script>
  import { initProjectReels } from "../../scripts/project-reel";

  initProjectReels();
</script>

<style>
  .solution-detail {
    overflow: clip;
  }
  .solution-detail__hero {
    background: var(--paper);
  }
  .solution-detail__hero-inner {
    display: grid;
    justify-items: center;
    padding-block: calc(var(--header-height) + clamp(2rem, 4vw, 3.5rem))
      clamp(4.5rem, 8vw, 8rem);
    text-align: center;
  }
  .solution-detail__hero-art {
    width: min(28rem, 64vw);
    aspect-ratio: 1122 / 1402;
  }
  .solution-detail__hero-art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .solution-detail__hero-copy {
    max-width: 52rem;
    margin-top: clamp(1.2rem, 2vw, 2.2rem);
  }
  .solution-detail__hero-copy .eyebrow {
    color: var(--forest);
  }
  .solution-detail__hero-copy h1 {
    max-width: 11ch;
    margin: 0.7rem auto 0;
    color: var(--forest);
  }
  .solution-detail__hero-summary {
    max-width: 35rem;
    margin: 1.8rem auto 0;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.5;
  }
  .solution-detail__hero-copy .action-link {
    margin-top: 1.7rem;
  }
  .solution-detail--compact .solution-detail__hero-inner {
    padding-block: calc(var(--header-height) + 1.5rem) clamp(3.5rem, 6vw, 5rem);
  }
  .solution-detail--compact .solution-detail__hero-art {
    width: min(20rem, 50vw);
  }
  .solution-detail__hero-art--transparent img {
    mix-blend-mode: normal;
  }
  .solution-detail--compact .solution-detail__hero-copy {
    max-width: 64rem;
    margin-top: clamp(2rem, 3vw, 3rem);
  }
  .solution-detail--compact .solution-detail__hero-copy h1 {
    max-width: 11ch;
    margin-top: 1.4rem;
    font-size: clamp(4rem, 7.6vw, 8rem);
    line-height: 0.9;
  }
  .solution-detail--compact .solution-detail__hero-summary {
    max-width: 39rem;
    margin-top: clamp(1.8rem, 2.5vw, 2.5rem);
  }
  .solution-detail__hero-cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(3rem, 3.8vw, 3.6rem);
  }
  .solution-detail__compact-decisions {
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .solution-detail__compact-decisions-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(22rem, 0.8fr);
    gap: clamp(2.5rem, 7vw, 8rem);
    align-items: center;
  }
  .solution-detail__compact-media {
    aspect-ratio: 1.08 / 1;
  }
  .solution-detail__compact-decisions-copy > .eyebrow {
    margin-bottom: 1rem;
    color: var(--forest);
  }
  .solution-detail__compact-decisions-copy .section-title {
    max-width: 10ch;
    color: var(--forest);
  }
  .solution-detail__compact-decisions-copy ol {
    margin-top: 2rem;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .solution-detail__compact-decisions-copy li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--line);
  }
  .solution-detail__compact-decisions-copy li > span {
    color: var(--forest);
    font-family: var(--display);
    font-size: 1.2rem;
  }
  .solution-detail__compact-decisions-copy h3 {
    color: var(--forest);
    font-family: var(--display);
    font-size: clamp(1.45rem, 2vw, 2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .solution-detail__compact-decisions-copy li p {
    max-width: 42ch;
    margin-top: 0.45rem;
    font-size: 0.82rem;
    line-height: 1.45;
  }
  .solution-detail__projects {
    padding-top: clamp(5rem, 9vw, 9rem);
    background: var(--paper);
  }
  .solution-detail__projects-intro {
    padding-bottom: clamp(3rem, 6vw, 6rem);
    text-align: center;
  }
  .solution-detail__projects-intro .eyebrow {
    margin-bottom: 1rem;
    color: var(--forest);
  }
  .solution-detail__projects-intro .section-title {
    max-width: 15ch;
    margin-inline: auto;
    color: var(--forest);
  }
  .solution-detail--compact .solution-detail__projects {
    padding-top: clamp(3.5rem, 6vw, 6rem);
  }
  .solution-detail--compact .solution-detail__projects-intro {
    padding-bottom: clamp(2.5rem, 4vw, 4rem);
  }
  .solution-detail__photo-stage {
    display: grid;
  }
  .solution-detail__photo-panel {
    position: relative;
    min-height: min(100svh, 56rem);
    display: block;
    isolation: isolate;
    overflow: clip;
    color: var(--white);
  }
  .solution-detail__photo-background {
    position: absolute;
    z-index: -2;
    inset: 0;
    overflow: hidden;
  }
  .solution-detail__photo-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform var(--motion-slow) var(--ease);
  }
  .solution-detail__photo-panel:hover .solution-detail__photo-background img {
    transform: scale(1.055);
  }
  .solution-detail__photo-veil {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(9, 17, 9, 0.08) 25%,
      rgba(9, 17, 9, 0.72) 100%
    );
  }
  .solution-detail__photo-sticky {
    position: sticky;
    top: 0;
    width: min(100% - (var(--gutter) * 2), 1730px);
    height: min(100svh, 56rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.72fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
    margin-inline: auto;
    padding-block: 3rem clamp(3rem, 7vw, 6.5rem);
  }
  .solution-detail__photo-content {
    align-self: end;
  }
  .solution-detail__photo-content .eyebrow {
    margin-bottom: 0.9rem;
    color: var(--leaf);
  }
  .solution-detail__photo-content strong {
    display: block;
    max-width: 10ch;
    font-family: var(--display);
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.065em;
  }
  .solution-detail__photo-content .tag-row {
    margin-top: 1.7rem;
  }
  .solution-detail__photo-detail {
    align-self: center;
    justify-self: end;
    width: min(100%, 36rem);
    aspect-ratio: 1.78 / 1;
  }
  .solution-detail__photo-detail .media__image {
    transition: transform var(--motion-slow) var(--ease);
  }
  .solution-detail__photo-panel:hover
    .solution-detail__photo-detail
    .media__image {
    transform: scale(1.018);
  }
  .solution-detail__photo-sequence--reel {
    position: relative;
    height: calc(var(--reel-count) * 100svh);
  }
  .solution-detail__photo-sequence--reel .solution-detail__photo-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--forest);
  }
  .solution-detail__photo-sequence--reel .solution-detail__photo-panel {
    position: absolute;
    z-index: var(--reel-stack);
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    transform: translate3d(0, var(--reel-scene-y), 0);
    will-change: transform;
  }
  .solution-detail__photo-sequence--reel .solution-detail__photo-background {
    overflow: hidden;
  }
  .solution-detail__photo-sequence--reel
    .solution-detail__photo-background
    img {
    position: absolute;
    top: -9%;
    left: 0;
    width: 100%;
    height: 118%;
    transform: translate3d(0, var(--reel-media-y), 0) scale(1.035);
    transition: none;
    will-change: transform;
  }
  .solution-detail__photo-sequence--reel
    .solution-detail__photo-panel:hover
    .solution-detail__photo-background
    img {
    transform: translate3d(0, var(--reel-media-y), 0) scale(1.035);
  }
  .solution-detail__photo-sequence--reel .solution-detail__photo-sticky {
    position: absolute;
    inset: 0;
    width: min(84%, 1730px);
    height: 100%;
    grid-template-columns: minmax(0, 0.82fr) minmax(30rem, 1fr);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 4.5rem);
    opacity: var(--reel-content-opacity);
    transform: translate3d(0, var(--reel-content-y), 0);
    will-change: transform;
  }
  .solution-detail__photo-sequence--reel .solution-detail__photo-content {
    align-self: center;
  }
  .solution-detail__photo-sequence--reel
    .solution-detail__photo-content
    strong {
    font-size: clamp(3.4rem, 5.5vw, 6.5rem);
  }
  .solution-detail__photo-sequence--reel .solution-detail__photo-detail {
    width: min(100%, 46rem);
  }
  .solution-detail__photo-sequence--reel .tag--light {
    border-color: rgba(248, 245, 236, 0.35);
    background: rgba(16, 20, 14, 0.5);
    backdrop-filter: blur(8px);
  }
  .solution-detail__compact-end {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    background: var(--surface);
  }
  .solution-detail__compact-end-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.72fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: start;
  }
  .solution-detail__compact-end-grid > div > .eyebrow {
    margin-bottom: 1rem;
    color: var(--forest);
  }
  .solution-detail__compact-end-grid .section-title {
    max-width: 12ch;
    color: var(--forest);
  }
  .solution-detail__compact-model-links {
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .solution-detail__compact-model-links a {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    transition: opacity var(--motion-fast) var(--ease);
  }
  .solution-detail__compact-model-links a:hover {
    opacity: 0.62;
  }
  .solution-detail__compact-model-links strong {
    color: var(--forest);
    font-family: var(--display);
    font-size: clamp(1.5rem, 2.2vw, 2.2rem);
    font-weight: 400;
    line-height: 1;
  }
  .solution-detail__compact-model-links span {
    align-self: center;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .solution-detail__compact-cta {
    padding: clamp(2rem, 4vw, 3.5rem);
    border-radius: var(--radius-media);
    background: var(--leaf);
  }
  .solution-detail__compact-cta .eyebrow {
    margin-bottom: 1rem;
    color: var(--forest);
  }
  .solution-detail__compact-cta h2 {
    color: var(--forest);
    font-family: var(--display);
    font-size: clamp(2.3rem, 3.7vw, 4rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }
  .solution-detail__compact-cta > p:not(.eyebrow) {
    max-width: 34ch;
    margin-top: 1.3rem;
    line-height: 1.5;
  }
  .solution-detail__compact-cta .action-link {
    margin-top: 2rem;
  }
  @media (max-width: 900px) {
    .solution-detail__hero-inner {
      padding-top: calc(var(--header-height) + 2.4rem);
    }
    .solution-detail__hero-art {
      width: min(27rem, 78vw);
    }
    .solution-detail__compact-decisions-grid,
    .solution-detail__compact-end-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .solution-detail__compact-decisions-copy {
      max-width: 42rem;
    }
  }
  @media (max-width: 560px) {
    .solution-detail__hero-inner {
      padding-bottom: 4.5rem;
    }
    .solution-detail__hero-art {
      width: min(23rem, 86vw);
    }
    .solution-detail--compact .solution-detail__hero-art {
      width: min(18rem, 78vw);
    }
    .solution-detail--compact .solution-detail__hero-copy {
      margin-top: 1.8rem;
    }
    .solution-detail--compact .solution-detail__hero-copy h1 {
      margin-top: 1.1rem;
      font-size: clamp(3.7rem, 17vw, 5.8rem);
    }
    .solution-detail--compact .solution-detail__hero-summary {
      margin-top: 1.5rem;
    }
    .solution-detail__hero-cta {
      margin-top: 2.75rem;
    }
    .solution-detail__photo-panel {
      min-height: 78svh;
    }
    .solution-detail__photo-sticky {
      height: 78svh;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-content: end;
      padding-bottom: 3rem;
    }
    .solution-detail__photo-detail {
      grid-row: 1;
      width: min(100%, 32rem);
      justify-self: end;
    }
    .solution-detail__photo-content {
      grid-row: 2;
    }
    .solution-detail__photo-content strong {
      font-size: clamp(3.2rem, 15vw, 5.5rem);
    }
    .solution-detail__photo-sequence--reel {
      height: calc(var(--reel-count) * 100svh);
    }
    .solution-detail__photo-sequence--reel .solution-detail__photo-stage {
      height: 100svh;
    }
    .solution-detail__photo-sequence--reel .solution-detail__photo-panel {
      height: 100%;
      min-height: 0;
    }
    .solution-detail__photo-sequence--reel .solution-detail__photo-sticky {
      width: min(100% - 2rem, 1730px);
      height: 100%;
      grid-template-columns: 1fr;
      align-items: end;
      align-content: end;
      padding-block: 2rem 3rem;
    }
    .solution-detail__photo-sequence--reel .solution-detail__photo-detail {
      width: min(100%, 32rem);
    }
    .solution-detail__compact-model-links a {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.55rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .solution-detail__photo-sequence--reel .solution-detail__photo-panel,
    .solution-detail__photo-sequence--reel
      .solution-detail__photo-background
      img,
    .solution-detail__photo-sequence--reel .solution-detail__photo-sticky {
      will-change: auto;
    }
  }
</style>
