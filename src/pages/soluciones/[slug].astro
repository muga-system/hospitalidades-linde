---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SolutionClosing from "../../components/solutions/SolutionClosing.astro";
import SolutionDecisions from "../../components/solutions/SolutionDecisions.astro";
import SolutionHero from "../../components/solutions/SolutionHero.astro";
import SolutionProjectReel from "../../components/solutions/SolutionProjectReel.astro";
import {
  featuredProjects,
  homeSolutionDetails,
  relatedModels,
  relatedProjects,
  solutions,
} from "../../data/content";
import type { Media, Solution } from "../../data/types";

export function getStaticPaths() {
  const solutionPages = [
    ...homeSolutionDetails,
    ...solutions.filter(
      (solution) =>
        !homeSolutionDetails.some((detail) => detail.slug === solution.slug),
    ),
  ];

  return solutionPages.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

const { solution } = Astro.props as { solution: Solution };
const linkedModels = relatedModels(solution.modelSlugs);
const linkedProjects = relatedProjects(solution.projectSlugs);
const projectSequence = [
  ...linkedProjects,
  ...featuredProjects.filter(
    (project) => !linkedProjects.some((item) => item.slug === project.slug),
  ),
].slice(0, 3);
const homeOrderIndex = homeSolutionDetails.findIndex(
  (detail) => detail.slug === solution.slug,
);
const broadOrderIndex = solutions.findIndex(
  (entry) => entry.slug === solution.slug,
);
const solutionNumber =
  homeOrderIndex >= 0 ? homeOrderIndex + 1 : broadOrderIndex + 1;
const fallbackMedia: Media = {
  src: "/images/library/threshold-linde.png",
  alt: "Galería protegida de LINDE en relación con el paisaje.",
  width: 1536,
  height: 1024,
};
const decisionMedia = projectSequence[0]?.images[1] ?? fallbackMedia;
---

<BaseLayout
  title={`${solution.title} — LINDE`}
  description={solution.summary}
  image={solution.image.src}
>
  <article class="page solution-detail solution-detail--compact">
    <SolutionHero
      title={solution.title}
      summary={solution.summary}
      number={solutionNumber}
      slug={solution.slug}
      media={solution.image}
    />
    <SolutionDecisions
      considerations={solution.considerations}
      media={decisionMedia}
    />
    {projectSequence.length > 0 && (
      <SolutionProjectReel projects={projectSequence} />
    )}
    {linkedModels.length > 0 && <SolutionClosing linkedModels={linkedModels} />}
  </article>
</BaseLayout>

<style>
  .solution-detail {
    overflow: clip;
  }
</style>
