---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/global/SiteFooter.astro';
import SiteHeader from '../components/global/SiteHeader.astro';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  headerMode?: 'default' | 'overlay';
  noFooter?: boolean;
  noHeader?: boolean;
};

const {
  title = 'LINDE — Arquitectura y desarrollo en territorio',
  description = 'Viviendas, refugios y proyectos de pequeña hospitalidad pensados desde el terreno hasta la obra.',
  image = '/images/home/hero-linde.png',
  headerMode = 'default',
  noFooter = false,
  noHeader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4d673b" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url.origin).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {!noHeader && <SiteHeader mode={headerMode} />}
    <main id="contenido" transition:animate="fade">
      <slot />
    </main>
    {!noFooter && <SiteFooter />}
    <script>
      const initReveals = () => {
        const targets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')].filter((target) => !target.classList.contains('is-visible'));
        if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const observer = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          }, { threshold: .12 });
          targets.forEach((target) => observer.observe(target));
        } else {
          targets.forEach((target) => target.classList.add('is-visible'));
        }
      };

      document.addEventListener('astro:page-load', initReveals);
      initReveals();
    </script>
  </body>
</html>
