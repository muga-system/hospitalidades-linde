---
import CtaArrow from "../global/CtaArrow.astro";
import { formatBedrooms } from "../../data/selectors";
import type { Model } from "../../data/types";

type Props = {
  linkedModels: Model[];
};

const { linkedModels } = Astro.props;
---

<section
  class="solution-detail__compact-end"
  aria-labelledby="compact-models-title"
>
  <div class="contained solution-detail__compact-end-grid">
    <div class="solution-detail__compact-models">
      <p class="eyebrow">Modelos relacionados</p>
      <h2 id="compact-models-title" class="section-title">
        Puntos de partida, sin cerrar la conversación.
      </h2>
      <div class="solution-detail__compact-model-links">
        {linkedModels.map((model) => (
          <a href={`/modelos/${model.slug}/`}>
            <strong>{model.name}</strong>
            <span class="solution-detail__compact-model-meta">
              <span>{model.areaM2} m² · {formatBedrooms(model.bedrooms)}</span>
              <span class="solution-detail__compact-model-action action-link action-link--hero action-link--wipe" aria-hidden="true">
                <span class="action-link__mark"><CtaArrow /></span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
    <aside class="solution-detail__compact-cta">
      <p class="eyebrow">Siguiente paso</p>
      <h2>Veamos qué puede sumar tu terreno.</h2>
      <p>
        Una primera conversación alcanza para ordenar el punto de partida y
        reconocer las decisiones importantes.
      </p>
    </aside>
  </div>
</section>

<style>
  .solution-detail__compact-end {
    padding-block: clamp(5rem, 9vw, 8rem);
    background: var(--surface);
  }
  .solution-detail__compact-end-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(28rem, 1fr);
    gap: clamp(3rem, 7vw, 8rem);
    align-items: center;
  }
  .solution-detail__compact-models > .eyebrow {
    margin-bottom: 1rem;
    color: var(--forest);
  }
  .solution-detail__compact-models .section-title {
    max-width: 12ch;
    font-size: clamp(2.8rem, 3.7vw, 4.1rem);
    line-height: 0.91;
    color: var(--forest);
  }
  .solution-detail__compact-model-links {
    max-width: 58rem;
    margin-top: clamp(2.5rem, 3.5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .solution-detail__compact-model-links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
    min-height: 5.25rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    transition: color var(--motion-fast) var(--ease);
  }
  .solution-detail__compact-model-links a:hover,
  .solution-detail__compact-model-links a:focus-visible { color: var(--ink); }
  .solution-detail__compact-model-links strong {
    color: var(--forest);
    font-family: var(--display);
    font-size: clamp(1.5rem, 2.2vw, 2.2rem);
    font-weight: 400;
    line-height: 1;
    transition: color var(--motion-fast) var(--ease);
  }
  .solution-detail__compact-model-links a:hover strong,
  .solution-detail__compact-model-links a:focus-visible strong { color: var(--ink); }
  .solution-detail__compact-model-meta {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 1.1rem;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .solution-detail__compact-model-action {
    --cta-height: 3rem;
    --cta-color: var(--white);
    --cta-wipe-background: var(--leaf);
    --cta-wipe-color: var(--ink);
    --cta-focus-color: var(--earth);
    flex: 0 0 auto;
  }
  .solution-detail__compact-model-links a:hover .solution-detail__compact-model-action,
  .solution-detail__compact-model-links a:focus-visible .solution-detail__compact-model-action {
    --cta-fill-position: 0% 50%;
    --cta-label-delay: 0ms;
    --cta-mark-delay: 150ms;
    --cta-arrow-out: translateX(145%);
    --cta-arrow-in: translate(0, 0);
    --cta-arrow-out-delay: 150ms;
    --cta-arrow-in-delay: 240ms;
  }
  .solution-detail__compact-cta {
    width: 100%;
    min-height: clamp(30rem, 36vw, 38rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 4vw, 4rem);
    border-radius: var(--radius-media);
    background: var(--leaf);
  }
  .solution-detail__compact-cta .eyebrow {
    margin-bottom: 1rem;
    color: var(--forest);
  }
  .solution-detail__compact-cta h2 {
    max-width: 14ch;
    color: var(--forest);
    font-family: var(--display);
    font-size: clamp(2.4rem, 3.25vw, 3.8rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }
  .solution-detail__compact-cta > p:not(.eyebrow) {
    max-width: 34ch;
    margin-top: 1.55rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .solution-detail__compact-end-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
      align-items: start;
    }
    .solution-detail__compact-cta { min-height: 28rem; }
  }

  @media (max-width: 560px) {
    .solution-detail__compact-model-links a {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.55rem;
    }
    .solution-detail__compact-model-links a { display: flex; }
    .solution-detail__compact-model-meta {
      width: 100%;
      justify-content: space-between;
      white-space: normal;
    }
  }
</style>
