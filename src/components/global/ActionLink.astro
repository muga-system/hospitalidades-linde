---
type Props = {
  href: string;
  label: string;
  variant?: 'default' | 'solid' | 'light' | 'hero' | 'nav';
  target?: string;
};

const { href, label, variant = 'default', target } = Astro.props;
const external = href.startsWith('http');
const hasWipe = variant === 'hero' || variant === 'nav';
---

<a class:list={['action-link', `action-link--${variant}`, { 'action-link--wipe': hasWipe }]} href={href} target={target} rel={external ? 'noreferrer' : undefined}>
  <span class="action-link__label">
    {label}
    {hasWipe && <span class="action-link__label-wipe" aria-hidden="true">{label}</span>}
  </span>
  {variant !== 'nav' && <span class="action-link__mark" aria-hidden="true">
    {variant === 'hero' ? (
      <span class="action-link__arrows">
        <svg class="action-link__arrow action-link__arrow--out" viewBox="0 0 26 26" fill="none" focusable="false">
          <path d="M4 13h18M15 4c0 4.5 3 9 7 9M15 22c0-4.5 3-9 7-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <svg class="action-link__arrow action-link__arrow--in" viewBox="0 0 26 26" fill="none" focusable="false">
          <path d="M4 13h18M15 4c0 4.5 3 9 7 9M15 22c0-4.5 3-9 7-9" transform="rotate(-45 13 13)" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    ) : '→'}
  </span>}
</a>
