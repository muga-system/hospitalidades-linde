---
type Props = {
  href: string;
  label: string;
  variant?: 'default' | 'solid' | 'light';
  target?: string;
};

const { href, label, variant = 'default', target } = Astro.props;
const external = href.startsWith('http');
---

<a class:list={['action-link', `action-link--${variant}`]} href={href} target={target} rel={external ? 'noreferrer' : undefined}>
  <span class="action-link__label">{label}</span>
  <span class="action-link__mark" aria-hidden="true">→</span>
</a>
