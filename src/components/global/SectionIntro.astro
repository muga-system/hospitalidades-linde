---
import ActionLink from './ActionLink.astro';

type Props = { eyebrow?: string; title: string; copy?: string; href?: string; action?: string; centered?: boolean };
const { eyebrow, title, copy, href, action, centered = false } = Astro.props;
---

<div class:list={['section-head', { 'section-head--center': centered }]} data-reveal>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="section-title">{title}</h2>
  </div>
  <div class="section-head__side">
    {copy && <p class="body-copy">{copy}</p>}
    {href && action && <div style="margin-top:1.4rem"><ActionLink href={href} label={action} /></div>}
  </div>
</div>
