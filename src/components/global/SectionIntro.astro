---
import ActionLink from './ActionLink.astro';

type Props = {
  eyebrow?: string;
  title: string;
  copy?: string;
  href?: string;
  action?: string;
  centered?: boolean;
  actionVariant?: 'default' | 'solid' | 'light' | 'hero' | 'nav';
  titleSpacing?: 'default' | 'roomy';
};

const { eyebrow, title, copy, href, action, centered = false, actionVariant = 'hero', titleSpacing = 'default' } = Astro.props;
---

<div class:list={['section-head', { 'section-head--center': centered }]} data-reveal>
  <div class:list={['section-head__title', { 'section-head__title--roomy': titleSpacing === 'roomy' }]}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="section-title">{title}</h2>
  </div>
  <div class="section-head__side">
    {copy && <p class="body-copy">{copy}</p>}
    {href && action && <div style="margin-top:1.4rem"><ActionLink href={href} label={action} variant={actionVariant} /></div>}
  </div>
</div>

<style>
  .section-head__title { display: grid; gap: clamp(1rem, 1.5vw, 1.35rem); }
  .section-head__title--roomy { gap: clamp(1.75rem, 2.4vw, 2.25rem); }
</style>
