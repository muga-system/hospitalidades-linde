---
import { models, navigationSolutions, projects, site } from '../../data/content';
import ActionLink from './ActionLink.astro';
import type { Media } from '../../data/types';
import { heroMedia, thresholdMedia } from '../../data/media';

type Props = { mode?: 'default' | 'overlay' };
const { mode = 'default' } = Astro.props;
type NavItem = { label: string; href: string; description: string; image?: Media };
type NavGroup = { key: string; label: string; activePaths: string[]; items: NavItem[] };

const navigationModels: NavItem[] = models.map((model) => ({
  label: model.name,
  href: `/modelos/${model.slug}/`,
  description: `${model.areaM2} m² · ${model.tagline}`,
  image: model.images[0],
}));

const navigationProjects: NavItem[] = projects.map((project) => ({
  label: project.name,
  href: `/proyectos/${project.slug}/`,
  description: `${project.city}, ${project.province} · ${project.areaM2} m²`,
  image: project.images[0],
}));

const navigationWork: NavItem[] = [
  {
    label: 'Proceso',
    href: '/proceso/',
    description: 'Del terreno a la obra, con un recorrido claro.',
    image: thresholdMedia,
  },
  {
    label: 'Servicios',
    href: '/servicios/',
    description: 'Alcances que acompañan decisiones y ejecución.',
    image: heroMedia,
  },
];

const navGroups: NavGroup[] = [
  { key: 'soluciones', label: 'Soluciones', activePaths: ['/soluciones'], items: navigationSolutions.map((item) => ({ label: item.title, href: item.href, description: item.summary, image: item.image })) },
  { key: 'modelos', label: 'Modelos', activePaths: ['/modelos'], items: navigationModels },
  { key: 'proyectos', label: 'Proyectos', activePaths: ['/proyectos'], items: navigationProjects },
  { key: 'trabajamos', label: 'Cómo trabajamos', activePaths: ['/proceso', '/servicios'], items: navigationWork },
];

const normalizedCurrentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const matchesCurrentPath = (path: string) => {
  const normalizedPath = path.replace(/\/+$/, '') || '/';
  return normalizedCurrentPath === normalizedPath || normalizedCurrentPath.startsWith(`${normalizedPath}/`);
};
const isCurrentGroup = (group: NavGroup) => group.activePaths.some(matchesCurrentPath);
---

<header class:list={['site-header', { 'site-header--overlay': mode === 'overlay' }]} data-site-header>
  <div class="site-header__bar">
    <a class="brand" href="/" aria-label="LINDE, inicio">
      <span class="brand__name">{site.brand}</span>
      <span class="brand__descriptor">Arquitectura<br />en territorio</span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {navGroups.map((group) => (
        <button class:list={['desktop-nav__trigger', { 'is-current-section': isCurrentGroup(group) }]} type="button" data-nav-trigger={group.key} aria-expanded="false" aria-controls={`nav-panel-${group.key}`}>
          {group.label}<span aria-hidden="true">+</span>
        </button>
      ))}
    </nav>

    <div class="header-cta"><ActionLink href={site.primaryCta.href} label={site.primaryCta.label} variant="nav" /></div>
    <button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" data-mobile-toggle>
      <span class="sr-only">Abrir menú</span><span aria-hidden="true">☰</span>
    </button>
  </div>

  <div class="desktop-panel" data-desktop-panel aria-hidden="true">
    <div class="desktop-panel__inner">
      {navGroups.map((group) => (
        <section class="desktop-panel__group" id={`nav-panel-${group.key}`} data-nav-panel={group.key} hidden>
          <p class="sr-only">{group.label}</p>
          <div class:list={['desktop-panel__grid', `desktop-panel__grid--${group.key}`]}>
            {group.items.map((item, index) => (
              <a class="desktop-panel__item" href={item.href} aria-current={matchesCurrentPath(item.href) ? 'page' : undefined}>
                {item.image ? (
                  <span class="desktop-panel__thumb"><img src={item.image.src} alt="" width={item.image.width} height={item.image.height} loading="lazy" decoding="async" /></span>
                ) : <span class="desktop-panel__index">{String(index + 1).padStart(2, '0')}</span>}
                <span>
                  <strong>{item.label}</strong>
                  <small>{item.description}</small>
                </span>
                {!item.image && <span class="desktop-panel__arrow" aria-hidden="true">↗</span>}
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <div class="mobile-panel" id="mobile-navigation" data-mobile-panel hidden role="dialog" aria-modal="true" aria-label="Navegación">
    <div class="mobile-panel__top">
      <span class="brand__name">LINDE</span>
      <button class="mobile-toggle mobile-toggle--close" type="button" data-mobile-close><span class="sr-only">Cerrar menú</span><span aria-hidden="true">×</span></button>
    </div>
    <nav aria-label="Navegación móvil">
      {navGroups.map((group) => (
        <details class:list={['mobile-group', { 'is-current-section': isCurrentGroup(group) }]}>
          <summary>{group.label}<span aria-hidden="true">+</span></summary>
          <div class="mobile-group__items">
            {group.items.map((item) => <a href={item.href} aria-current={matchesCurrentPath(item.href) ? 'page' : undefined}>{item.label}</a>)}
          </div>
        </details>
      ))}
    </nav>
    <div class="mobile-panel__cta"><ActionLink href={site.primaryCta.href} label={site.primaryCta.label} variant="nav" /></div>
  </div>
</header>

<script>
  const initSiteHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.initialized === 'true') return;
    header.dataset.initialized = 'true';
    const desktopPanel = header.querySelector<HTMLElement>('[data-desktop-panel]');
    const triggers = [...header.querySelectorAll<HTMLButtonElement>('[data-nav-trigger]')];
    const panels = [...header.querySelectorAll<HTMLElement>('[data-nav-panel]')];
    const mobilePanel = header.querySelector<HTMLElement>('[data-mobile-panel]');
    const mobileToggle = header.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
    const mobileClose = header.querySelector<HTMLButtonElement>('[data-mobile-close]');
    let activeMenu = '';

    const updateHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 22);
    const closeDesktop = () => {
      activeMenu = '';
      header.classList.remove('is-menu-open');
      desktopPanel?.setAttribute('aria-hidden', 'true');
      triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
      panels.forEach((panel) => { panel.hidden = true; });
    };
    const openDesktop = (key: string) => {
      activeMenu = key;
      header.classList.add('is-menu-open');
      desktopPanel?.setAttribute('aria-hidden', 'false');
      triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', String(trigger.dataset.navTrigger === key)));
      panels.forEach((panel) => { panel.hidden = panel.dataset.navPanel !== key; });
    };
    const closeMobile = () => {
      if (!mobilePanel) return;
      mobilePanel.hidden = true;
      document.documentElement.style.overflow = '';
      mobileToggle?.setAttribute('aria-expanded', 'false');
      mobileToggle?.focus();
    };
    const openMobile = () => {
      if (!mobilePanel) return;
      mobilePanel.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      mobileToggle?.setAttribute('aria-expanded', 'true');
      mobileClose?.focus();
    };

    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
    triggers.forEach((trigger) => trigger.addEventListener('click', () => activeMenu === trigger.dataset.navTrigger ? closeDesktop() : openDesktop(trigger.dataset.navTrigger || '')));
    mobileToggle?.addEventListener('click', openMobile);
    mobileClose?.addEventListener('click', closeMobile);
    header.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target.closest('a')) { closeDesktop(); closeMobile(); }
    });
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (activeMenu && !header.contains(target)) closeDesktop();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { closeDesktop(); closeMobile(); }
    });
  };

  document.addEventListener('astro:page-load', initSiteHeader);
  document.addEventListener('astro:before-preparation', () => { document.documentElement.style.overflow = ''; });
  initSiteHeader();
</script>

<style>
  .site-header { position: fixed; z-index: 30; top: 0; left: 0; width: 100%; color: var(--ink); transition: color var(--motion-base) var(--ease); }
  .site-header__bar { height: var(--header-height); display: grid; grid-template-columns: max-content 1fr max-content; align-items: center; gap: 2rem; padding-inline: var(--gutter); position: relative; z-index: 2; }
  .site-header--overlay:not(.is-scrolled):not(.is-menu-open) { color: var(--white); }
  .site-header.is-scrolled .site-header__bar { background: rgba(246,243,234,.94); border-bottom: 1px solid rgba(25,32,23,.08); backdrop-filter: blur(10px); }
  .brand { display: flex; align-items: center; gap: .6rem; }
  .brand__name { font-family: var(--display); font-size: 1.7rem; letter-spacing: -.07em; line-height: .8; }
  .brand__descriptor { font-size: .52rem; font-weight: 700; letter-spacing: .04em; line-height: 1.08; text-transform: uppercase; }
  .desktop-nav { display: flex; align-items: center; justify-content: flex-end; gap: clamp(.75rem, 1.4vw, 1.45rem); font-size: .7rem; font-weight: 700; letter-spacing: .025em; }
  .desktop-nav a, .desktop-nav__trigger { white-space: nowrap; }
  .desktop-nav__trigger { display: inline-flex; gap: .3rem; border: 0; padding: 0; color: inherit; background: transparent; font: inherit; transition: color var(--motion-fast) var(--ease); }
  .desktop-nav__trigger.is-current-section { color: var(--forest); }
  .site-header--overlay:not(.is-scrolled):not(.is-menu-open) .desktop-nav__trigger.is-current-section { color: var(--leaf); }
  .desktop-nav__trigger span { transition: transform var(--motion-base) var(--ease); }
  .desktop-nav__trigger[aria-expanded="true"] span { transform: rotate(45deg); }
  .header-cta, .mobile-panel__cta { --cta-height: 2.75rem; --cta-padding: .72rem 1.3rem; --cta-font-size: .68rem; --cta-font-weight: 750; display: flex; align-items: center; white-space: nowrap; }
  .mobile-toggle { display: none; border: 0; width: 2.65rem; height: 2.65rem; place-items: center; border-radius: 50%; color: var(--ink); background: var(--leaf); font-size: 1rem; }
  .desktop-panel { position: absolute; z-index: 1; top: 0; left: 0; width: 100%; padding-top: var(--header-height); color: var(--ink); background: var(--paper); border-radius: 0 0 2.5rem 2.5rem; box-shadow: 0 18px 42px rgba(25,32,23,.13); opacity: 0; pointer-events: none; transform: translateY(-1rem); transition: opacity var(--motion-base) var(--ease), transform var(--motion-slow) var(--ease); }
  .site-header.is-menu-open .desktop-panel { opacity: 1; pointer-events: auto; transform: none; }
  .desktop-panel__inner { padding: 3.4rem var(--gutter) 3.8rem; }
  .desktop-panel__group[hidden] { display: none; }
  .desktop-panel__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .desktop-panel__grid--soluciones { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6rem clamp(1.25rem, 3vw, 3.5rem); background: transparent; border: 0; }
  .desktop-panel__grid--modelos { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6rem clamp(1.25rem, 3vw, 3.5rem); background: transparent; border: 0; }
  .desktop-panel__grid--proyectos { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6rem clamp(1.25rem, 3vw, 3.5rem); background: transparent; border: 0; }
  .desktop-panel__grid--trabajamos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem clamp(1.25rem, 3vw, 3.5rem); background: transparent; border: 0; }
  .desktop-panel__item { min-height: 7.7rem; display: grid; grid-template-columns: 2rem 1fr 1.3rem; gap: .6rem; padding: 1.15rem; background: var(--surface); transition: background var(--motion-base) var(--ease), transform var(--motion-base) var(--ease); }
  .desktop-panel__item:hover { background: var(--leaf); }
  .desktop-panel__grid--soluciones .desktop-panel__item, .desktop-panel__grid--modelos .desktop-panel__item, .desktop-panel__grid--proyectos .desktop-panel__item, .desktop-panel__grid--trabajamos .desktop-panel__item { grid-template-columns: 7.2rem minmax(0, 1fr); gap: 1.15rem; min-height: 7.2rem; padding: 0; color: var(--ink); background: transparent; transition: color var(--motion-base) var(--ease); }
  .desktop-panel__grid--soluciones .desktop-panel__item:is(:hover, :focus-visible), .desktop-panel__grid--modelos .desktop-panel__item:is(:hover, :focus-visible), .desktop-panel__grid--proyectos .desktop-panel__item:is(:hover, :focus-visible), .desktop-panel__grid--trabajamos .desktop-panel__item:is(:hover, :focus-visible) { color: var(--forest); background: transparent; transform: none; }
  .desktop-panel__grid--soluciones .desktop-panel__item:is(:hover, :focus-visible) .desktop-panel__thumb, .desktop-panel__grid--modelos .desktop-panel__item:is(:hover, :focus-visible) .desktop-panel__thumb, .desktop-panel__grid--proyectos .desktop-panel__item:is(:hover, :focus-visible) .desktop-panel__thumb, .desktop-panel__grid--trabajamos .desktop-panel__item:is(:hover, :focus-visible) .desktop-panel__thumb { border-color: var(--forest); background: var(--leaf); }
  .desktop-panel__grid--soluciones .desktop-panel__item:is(:hover, :focus-visible) small, .desktop-panel__grid--modelos .desktop-panel__item:is(:hover, :focus-visible) small, .desktop-panel__grid--proyectos .desktop-panel__item:is(:hover, :focus-visible) small, .desktop-panel__grid--trabajamos .desktop-panel__item:is(:hover, :focus-visible) small { color: var(--ink); }
  .desktop-panel__thumb { display: block; width: 7.2rem; height: 7.2rem; overflow: hidden; border: 1px solid rgba(25,32,23,.2); border-radius: 1.05rem; background: var(--surface); transition: border-color var(--motion-base) var(--ease), background-color var(--motion-base) var(--ease); }
  .desktop-panel__thumb img { width: 100%; height: 100%; object-fit: contain; object-position: center; transition: opacity var(--motion-base) var(--ease); }
  .desktop-panel__grid--soluciones .desktop-panel__item > span:last-child { align-self: center; }
  .desktop-panel__grid--modelos .desktop-panel__thumb, .desktop-panel__grid--proyectos .desktop-panel__thumb, .desktop-panel__grid--trabajamos .desktop-panel__thumb { height: 7.2rem; align-self: center; }
  .desktop-panel__grid--modelos .desktop-panel__thumb img, .desktop-panel__grid--proyectos .desktop-panel__thumb img, .desktop-panel__grid--trabajamos .desktop-panel__thumb img { object-fit: cover; object-position: center; }
  .desktop-panel__index { font-size: .64rem; font-weight: 700; color: var(--forest); }
  .desktop-panel__item strong { display: block; margin-bottom: .45rem; font-family: var(--display); font-size: 1.45rem; font-weight: 500; line-height: 1; letter-spacing: -.045em; }
  .desktop-panel__grid--soluciones .desktop-panel__item strong, .desktop-panel__grid--modelos .desktop-panel__item strong, .desktop-panel__grid--proyectos .desktop-panel__item strong, .desktop-panel__grid--trabajamos .desktop-panel__item strong { font-size: clamp(1.25rem, 1.55vw, 1.7rem); }
  .desktop-panel__item small { display: block; max-width: 27ch; color: rgba(100,76,65,.94); font-size: .72rem; line-height: 1.38; }
  .desktop-panel__grid--soluciones .desktop-panel__item small, .desktop-panel__grid--modelos .desktop-panel__item small, .desktop-panel__grid--proyectos .desktop-panel__item small, .desktop-panel__grid--trabajamos .desktop-panel__item small { max-width: 27ch; font-size: .76rem; }
  .desktop-panel__arrow { align-self: end; font-size: .85rem; }
  .mobile-panel { display: none; }
  @media (max-width: 1100px) { .desktop-nav { gap: .7rem; } .header-cta { --cta-font-size: .62rem; } }
  @media (max-width: 900px) {
    .site-header__bar { grid-template-columns: 1fr max-content; padding-inline: 1.25rem; }
    .desktop-nav, .header-cta, .desktop-panel { display: none; }
    .mobile-toggle { display: grid; }
    .mobile-panel { display: block; position: fixed; z-index: 3; top: 0; left: 0; width: 100%; height: 100svh; padding: 1.25rem 1.25rem 1.4rem; color: var(--ink); background: var(--paper); border-radius: 0 0 2.25rem 2.25rem; overflow: auto; }
    .mobile-panel[hidden] { display: none; }
    .mobile-panel__top { display: flex; min-height: 3.2rem; align-items: center; justify-content: space-between; margin-bottom: 3rem; }
    .mobile-toggle--close { display: grid; font-size: 1.8rem; line-height: 1; }
    .mobile-group { border-top: 1px solid var(--line); }
    .mobile-group:last-of-type { border-bottom: 1px solid var(--line); }
    .mobile-group summary, .mobile-panel__direct { display: flex; align-items: center; justify-content: space-between; min-height: 4.1rem; font-family: var(--display); font-size: clamp(1.8rem, 8vw, 2.55rem); letter-spacing: -.05em; list-style: none; }
    .mobile-group summary::-webkit-details-marker { display: none; }
    .mobile-group.is-current-section summary, .mobile-group__items a[aria-current='page'] { color: var(--forest); }
    .mobile-group summary span { font-family: var(--ui); font-size: 1.3rem; }
    .mobile-group[open] summary span { transform: rotate(45deg); }
    .mobile-group__items { display: grid; gap: .75rem; padding: 0 0 1.2rem; }
    .mobile-group__items a { font-size: .82rem; font-weight: 650; }
    .mobile-panel__direct { border-bottom: 1px solid var(--line); }
    .mobile-panel__cta { --cta-height: 3.2rem; --cta-padding: .72rem 1.1rem; width: 100%; margin-top: 1.5rem; }
  }
</style>
