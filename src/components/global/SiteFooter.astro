---
import { homeSolutions, models, site } from '../../data/content';
import ActionLink from './ActionLink.astro';
---

<footer class="site-footer">
  <section class="site-footer__cta">
    <div class="contained site-footer__cta-grid">
      <img class="site-footer__cta-art" src="/imagenes/casa-dos-generaciones-transparente.webp?v=home-restored-20260901" alt="Ilustración LINDE de una casa vinculada al paisaje." width="1122" height="1402" loading="lazy" />
      <div>
        <p class="eyebrow">¿Estás pensando un lugar?</p>
        <h2 class="display-l">Empecemos por lo que el terreno ya está diciendo.</h2>
      </div>
      <ActionLink href="/empezar/" label="Contanos tu proyecto" variant="hero" />
    </div>
  </section>
  <div class="site-footer__body">
    <div class="contained site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__name">LINDE</p>
        <p>Arquitectura y desarrollo<br />en territorio.</p>
        <p class="demo-note">Demo conceptual · datos y métricas ficticias.</p>
      </div>
      <div>
        <p class="eyebrow">Soluciones</p>
        <ul>{homeSolutions.map((item) => <li><a href={item.href}>{item.title}</a></li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">Modelos</p>
        <ul>{models.slice(0, 4).map((item) => <li><a href={`/modelos/${item.slug}/`}>{item.name}</a></li>)}<li><a href="/modelos/">Ver todos</a></li></ul>
      </div>
      <div>
        <p class="eyebrow">LINDE</p>
        <ul><li><a href="/proyectos/">Proyectos</a></li><li><a href="/proceso/">Proceso</a></li><li><a href="/servicios/">Servicios</a></li></ul>
      </div>
      <div>
        <p class="eyebrow">Contacto</p>
        <ul><li><a href={`mailto:${site.email}`}>{site.email}</a></li>{site.social.map((item) => <li><a href={item.href} target="_blank" rel="noreferrer">{item.label}</a></li>)}</ul>
      </div>
    </div>
    <div class="contained site-footer__bottom"><span>© {new Date().getFullYear()} LINDE</span><span>Patagonia, Argentina · Demo</span></div>
  </div>
</footer>

<style>
  .site-footer { color: var(--white); background: var(--ink); }
  .site-footer__cta { color: var(--ink); background: var(--leaf); border-radius: 2rem 2rem 0 0; overflow: hidden; }
  .site-footer__cta-grid { min-height: 27rem; display: grid; align-items: center; grid-template-columns: minmax(8rem, .3fr) minmax(0, 1fr) auto; gap: clamp(1.5rem, 5vw, 5rem); }
  .site-footer__cta-art { align-self: end; width: min(13rem, 18vw); height: 17rem; object-fit: contain; object-position: center bottom; mix-blend-mode: multiply; }
  .site-footer__cta-grid .display-l { max-width: 12ch; }
  .site-footer__cta .site-footer__cta-grid .eyebrow { margin-bottom: .75rem; color: #8da16e; }
  .site-footer__cta-grid .action-link { justify-self: end; }
  .site-footer__cta-grid .action-link--hero { --cta-wipe-background: var(--white); --cta-wipe-color: var(--ink); --cta-focus-color: var(--ink); }
  .site-footer__body { padding-top: clamp(4rem, 8vw, 8rem); }
  .site-footer__grid { display: grid; grid-template-columns: 1.9fr repeat(4, 1fr); gap: 2rem; padding-bottom: clamp(4rem, 7vw, 7rem); }
  .site-footer__name { margin-bottom: .7rem; font-family: var(--display); font-size: clamp(5rem, 11vw, 10rem); letter-spacing: -.09em; line-height: .72; }
  .site-footer__brand > p:not(.site-footer__name) { max-width: 19ch; font-size: .82rem; line-height: 1.4; }
  .site-footer__brand .demo-note { margin-top: 2rem; color: rgba(248,245,236,.55); }
  .site-footer .eyebrow { margin-bottom: 1.2rem; color: var(--moss); }
  .site-footer ul { list-style: none; display: grid; gap: .58rem; font-size: .78rem; }
  .site-footer a { transition: color var(--motion-fast) var(--ease); }
  .site-footer a:hover { color: var(--leaf); }
  .site-footer__bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.2rem; border-top: 1px solid rgba(248,245,236,.18); color: rgba(248,245,236,.55); font-size: .66rem; letter-spacing: .035em; text-transform: uppercase; }
  @media (max-width: 900px) { .site-footer__cta-grid { min-height: 25rem; grid-template-columns: minmax(7rem, .35fr) 1fr; gap: 1.4rem; } .site-footer__cta-grid .action-link { grid-column: 2; justify-self: start; } .site-footer__cta-art { width: 9rem; height: 14rem; } .site-footer__grid { grid-template-columns: repeat(2, 1fr); } .site-footer__brand { grid-column: span 2; } }
  @media (max-width: 560px) { .site-footer__cta { border-radius: 1.5rem 1.5rem 0 0; } .site-footer__cta-grid { min-height: 31rem; grid-template-columns: 1fr; gap: 1.2rem; padding-block: 3.5rem; } .site-footer__cta-art { width: 9rem; height: 10rem; justify-self: center; } .site-footer__cta-grid .action-link { grid-column: auto; justify-self: start; } .site-footer__grid { gap: 2.2rem 1rem; } .site-footer__bottom { align-items: start; display: grid; gap: .5rem; } }
</style>
