---
import CtaArrow from '../global/CtaArrow.astro';
import type { HomeSolutionCard } from '../../data/types';

type Props = { solution: HomeSolutionCard; index: number };
const { solution, index } = Astro.props;
---

<article class="solution-entry">
  <a href={solution.href} style={`--solution-image-ratio: ${solution.image.width} / ${solution.image.height};`}>
    <span class="solution-entry__number">{String(index + 1).padStart(2, '0')}</span>
    <h3 class="solution-entry__title">{solution.title}</h3>
    <figure class="solution-entry__media media media--rounded">
      <img class="media__image" data-horizontal-image src={solution.image.src} alt={solution.image.alt} width={solution.image.width} height={solution.image.height} loading="lazy" decoding="async" style={`object-position:${solution.image.position ?? 'center'};`} />
    </figure>
    <div class="solution-entry__text">
      <p>{solution.summary}</p>
      <span class="solution-entry__action action-link action-link--hero action-link--wipe" aria-hidden="true">
        <span class="action-link__mark"><CtaArrow /></span>
      </span>
    </div>
  </a>
</article>

<style>
  .solution-entry a { position: relative; display: flex; aspect-ratio: var(--solution-image-ratio); min-height: 0; align-items: flex-end; overflow: hidden; border-radius: var(--radius-media); background: var(--paper); }
  .solution-entry a::after { content: ''; position: absolute; z-index: 2; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(25,32,23,.2); pointer-events: none; }
  .solution-entry__media { position: absolute; inset: 0; border-radius: inherit; background: var(--paper); }
  .solution-entry__media .media__image { object-fit: contain; transform: none; }
  .solution-entry__number { position: absolute; z-index: 1; top: 1rem; left: 1rem; color: var(--ink); font-size: .68rem; font-weight: 700; letter-spacing: .07em; }
  .solution-entry__title { position: absolute; z-index: 1; top: 3.6rem; left: 1.8rem; right: 1.8rem; max-width: 12ch; color: var(--ink); font-family: var(--display); font-size: clamp(2rem, 3.2vw, 3.4rem); font-weight: 400; line-height: .96; letter-spacing: -.06em; }
  .solution-entry__text { position: relative; z-index: 1; width: 100%; max-width: 30rem; padding: 0 1.8rem 1.7rem; }
  .solution-entry__text p { margin-top: .9rem; font-size: .82rem; line-height: 1.5; }
  .solution-entry__action { --cta-height: 3rem; --cta-color: var(--white); --cta-wipe-background: var(--leaf); --cta-wipe-color: var(--ink); --cta-focus-color: var(--earth); margin-top: 1.25rem; }
  .solution-entry a:hover .solution-entry__media .media__image { transform: none; }
  .solution-entry a:is(:hover, :focus-visible) .solution-entry__action { --cta-fill-position: 0% 50%; --cta-label-delay: 0ms; --cta-mark-delay: 150ms; --cta-arrow-out: translateX(145%); --cta-arrow-in: translate(0, 0); --cta-arrow-out-delay: 150ms; --cta-arrow-in-delay: 240ms; }
</style>
