---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../../data/content';
---

<section class="project-explorer" data-project-explorer aria-label="Proyectos de LINDE">
  <div class="project-explorer__bar contained">
    <div>
      <p class="eyebrow">Portfolio · Patagonia</p>
      <h1 class="page-title">Proyectos para leer en conjunto.</h1>
    </div>
    <div class="project-explorer__intro">
      <p class="body-copy">Seis escenarios demo para ver cómo una decisión de sitio, programa y escala encuentra una respuesta concreta.</p>
      <button class="filter-button" type="button" data-filter-toggle aria-expanded="false">Filtrar <span aria-hidden="true">+</span></button>
    </div>
  </div>

  <div class="project-explorer__filter contained" data-filter-panel hidden>
    <p class="meta">Tipo de punto de partida</p>
    <div class="project-explorer__filter-row" role="group" aria-label="Filtros de proyecto">
      <button class="is-active" type="button" data-filter="all">Todos <span>{projects.length}</span></button>
      <button type="button" data-filter="vivienda-territorio">Vivienda</button>
      <button type="button" data-filter="refugio">Refugio</button>
      <button type="button" data-filter="hospitalidad">Hospitalidad</button>
      <button type="button" data-filter="unidad-complementaria">Unidad complementaria</button>
    </div>
  </div>

  <div class="project-explorer__grid contained">
    {projects.map((project, index) => (
      <div class:list={['project-explorer__card', { 'project-explorer__card--lead': index === 0 }]} data-project-card data-solutions={project.solutionSlugs.join(' ')}>
        <ProjectCard project={project} index={index} variant={index === 0 ? 'feature' : 'grid'} />
      </div>
    ))}
    <p class="project-explorer__none empty-notice" data-no-results hidden>No hay proyectos demo para este filtro todavía.</p>
  </div>
</section>

<script>
  import { initProjectExplorer } from '../../scripts/project-explorer';
  initProjectExplorer();
</script>

<style>
  .project-explorer { padding-top: var(--header-height); }
  .project-explorer__bar { display: grid; grid-template-columns: 1fr minmax(17rem, .48fr); align-items: end; gap: clamp(2rem, 7vw, 8rem); padding-top: clamp(4.2rem, 7vw, 7.2rem); padding-bottom: clamp(2.2rem, 4vw, 4rem); }
  .project-explorer__bar .eyebrow { margin-bottom: .9rem; color: var(--forest); }
  .project-explorer__intro { display: grid; gap: 1.5rem; justify-items: start; }
  .project-explorer__intro .body-copy { max-width: 33ch; }
  .filter-button { border: 1px solid var(--line); padding: .67rem .88rem; border-radius: 999px; color: var(--ink); background: transparent; font-size: .67rem; font-weight: 750; letter-spacing: .045em; text-transform: uppercase; transition: border-color var(--motion-fast) var(--ease), background-color var(--motion-fast) var(--ease); }
  .filter-button:hover, .filter-button:focus-visible { border-color: var(--forest); background: rgba(220,234,160,.42); }
  .filter-button span { padding-left: .35rem; }
  .filter-button[aria-expanded="true"] span { display: inline-block; transform: rotate(45deg); }
  .project-explorer__filter { padding-bottom: clamp(1.8rem, 3vw, 3rem); }
  .project-explorer__filter[hidden] { display: none; }
  .project-explorer__filter .meta { margin-bottom: .75rem; color: var(--forest); }
  .project-explorer__filter-row { display: flex; flex-wrap: wrap; gap: .55rem; }
  .project-explorer__filter-row button { border: 1px solid var(--line); padding: .57rem .7rem; border-radius: 999px; color: var(--ink); background: transparent; font-size: .67rem; font-weight: 700; transition: border-color var(--motion-fast) var(--ease), background-color var(--motion-fast) var(--ease), color var(--motion-fast) var(--ease); }
  .project-explorer__filter-row button:not(.is-active):hover, .project-explorer__filter-row button:not(.is-active):focus-visible { border-color: var(--forest); background: rgba(220,234,160,.42); }
  .project-explorer__filter-row button.is-active { border-color: var(--forest); color: var(--white); background: var(--forest); }
  .project-explorer__filter-row span { margin-left: .25rem; opacity: .7; }
  .project-explorer__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2.5rem, 5vw, 6rem) clamp(1rem, 2.4vw, 2.6rem); padding-bottom: clamp(5rem, 10vw, 11rem); }
  .project-explorer__card--lead { grid-column: span 2; }
  .project-explorer__grid [data-project-card][hidden] { display: none; }
  .project-explorer__none { grid-column: 1 / -1; }
  @media (max-width: 800px) {
    .project-explorer__bar { grid-template-columns: 1fr; align-items: start; gap: 1.4rem; }
    .project-explorer__intro { gap: 1.1rem; }
    .project-explorer__grid { grid-template-columns: 1fr 1fr; gap: 2.8rem 1rem; }
    .project-explorer__card--lead { grid-column: span 2; }
  }
  @media (max-width: 520px) {
    .project-explorer__grid { grid-template-columns: 1fr; gap: 2.8rem; }
    .project-explorer__card--lead { grid-column: auto; }
  }
</style>
