---
import CtaArrow from '../global/CtaArrow.astro';
import { formatBedrooms, models, statusLabel } from '../../data/content';
import type { Project } from '../../data/types';

type Props = { project: Project; index?: number; variant?: 'grid' | 'feature' | 'plain' };
const { project, index = 0, variant = 'grid' } = Astro.props;
const cover = project.images[0];
const projectModel = models.find((model) => model.slug === project.modelSlugs[0]);
---

<article class:list={['project-card', `project-card--${variant}`]}>
  <a class="project-card__link" href={`/proyectos/${project.slug}/`}>
    <figure class="project-card__media media media--rounded">
      <img class="media__image" src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading={index > 0 ? 'lazy' : 'eager'} style={`object-position:${cover.position ?? 'center'};`} />
      <span class="project-card__status tag tag--light">{statusLabel[project.status]}<small>Demo</small></span>
    </figure>
    <div class="project-card__body">
      <div>
        <h3 class="project-card__name">{project.name}</h3>
        <p>{project.city}, {project.province}</p>
      </div>
      <div class="project-card__meta">
        <span>{project.areaM2} m²</span>
        {project.bedrooms !== undefined && <span>{formatBedrooms(project.bedrooms)}</span>}
        <span>{projectModel?.name ?? 'Modelo asociado'}</span>
      </div>
      <span class="project-card__action action-link action-link--hero action-link--wipe" aria-hidden="true">
        <span class="action-link__mark"><CtaArrow /></span>
      </span>
    </div>
  </a>
</article>

<style>
  .project-card__link { display: block; }
  .project-card__media { aspect-ratio: 4 / 3; }
  .project-card--feature .project-card__media { aspect-ratio: 1.25 / 1; }
  .project-card__status { position: absolute; left: 1rem; bottom: .9rem; display: inline-flex; align-items: center; gap: .45rem; }
  .project-card__status small { color: var(--leaf); font-size: .58rem; }
  .project-card__body { position: relative; padding: .9rem .1rem 0; }
  .project-card__name { font-family: var(--display); font-size: clamp(1.7rem, 2.9vw, 3rem); font-weight: 400; letter-spacing: -.055em; line-height: .96; }
  .project-card__body p { margin-top: .35rem; font-size: .73rem; }
  .project-card__meta { display: flex; flex-wrap: wrap; gap: .35rem .7rem; margin-top: .9rem; padding-right: 3.6rem; color: var(--forest); font-size: .65rem; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; }
  .project-card__meta span + span::before { content: '·'; margin-right: .7rem; color: var(--earth); }
  .project-card__action { --cta-height: 3rem; --cta-color: var(--white); --cta-wipe-background: var(--leaf); --cta-wipe-color: var(--ink); --cta-focus-color: var(--earth); position: absolute; right: 0; bottom: 0; }
  .project-card:hover .project-card__action,
  .project-card:focus-within .project-card__action { --cta-fill-position: 0% 50%; --cta-label-delay: 0ms; --cta-mark-delay: 150ms; --cta-arrow-out: translateX(145%); --cta-arrow-in: translate(0, 0); --cta-arrow-out-delay: 150ms; --cta-arrow-in-delay: 240ms; }
</style>
